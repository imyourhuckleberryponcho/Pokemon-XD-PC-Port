+// --- Patch 0028: GPU timing without Tracy ---------------------------------------------------------------
+// Totals over a reporting window (default 10 s), logged by after_submit() on the render worker. GPU times come
+// from the timestamp queries above (a frame = first to last timestamp of one GX frame packet; a pass = its
+// begin/end pair; a zone includes the passes recorded inside it). CPU times: "record" = the GX thread from
+// begin_frame to end_frame, "worker" = the render worker's encode + submit of that frame.
+float g_reportSeconds = 0.f;
+struct NameTotal {
+  uint64_t ns = 0;
+  uint32_t count = 0;
+};
+struct Window {
+  int64_t startNs = 0;
+  uint32_t frames = 0;
+  uint64_t gpuNs = 0;
+  uint64_t busyNs = 0;
+  std::vector<uint32_t> frameUs;
+  std::map<std::string, NameTotal> names;
+  uint32_t overflowFrames = 0;
+  // Bytes sent to the GPU per frame (AuroraStats, summed at each frame_end) and draws.
+  uint64_t statFrames = 0, verts = 0, uniforms = 0, indices = 0, storage = 0, textures = 0, draws = 0;
+};
+Window g_window;
+std::atomic_int64_t g_cpuNs[2]{};
+std::atomic_uint32_t g_cpuCount[2]{};
+std::atomic_uint32_t g_cpuMaxUs[2]{};
+std::atomic_bool g_overflowed{false};
+int64_t g_workerStartNs = 0; // (render worker only)
+
+void report_window(int64_t now) {
+  auto& w = g_window;
+  const double seconds = double(now - w.startNs) * 1e-9;
+  if (w.frames == 0) {
+    Log.info("[gpu timing] {:.1f} s: {} frames ({:.1f}/s), GPU time not measured (no timestamp queries here)",
+             seconds, w.statFrames, w.statFrames / seconds);
+  } else {
+    std::sort(w.frameUs.begin(), w.frameUs.end());
+    const double avg = double(w.gpuNs) * 1e-6 / w.frames;
+    const double p95 = w.frameUs[std::min<size_t>(w.frameUs.size() - 1, w.frameUs.size() * 95 / 100)] * 1e-3;
+    const double mx = w.frameUs.back() * 1e-3;
+    Log.info("[gpu timing] {:.1f} s: {} frames ({:.1f}/s), GPU {:.2f} ms/frame (passes busy {:.2f}, p95 {:.2f}, max "
+             "{:.2f}){}",
+             seconds, w.frames, w.frames / seconds, avg, double(w.busyNs) * 1e-6 / w.frames, p95, mx,
+             w.overflowFrames != 0 ? fmt::format(", {} frames had more than {} passes (rest not timed)",
+                                                 w.overflowFrames, MaxZones)
+                                   : std::string{});
+    std::vector<std::pair<std::string, NameTotal>> sorted(w.names.begin(), w.names.end());
+    std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b) { return a.second.ns > b.second.ns; });
+    for (const auto& [name, total] : sorted) {
+      Log.info("[gpu timing]   {:<22} {:7.3f} ms/frame {:5.1f}%  {:6.1f} per frame", name,
+               double(total.ns) * 1e-6 / w.frames, 100.0 * double(total.ns) / double(std::max<uint64_t>(1, w.gpuNs)),
+               double(total.count) / w.frames);
+    }
+  }
+  if (w.statFrames != 0) {
+    const double n = double(w.statFrames) * 1024.0;
+    Log.info("[gpu timing]   uploads per frame: vertices {:.0f} KB, uniforms {:.0f} KB, indices {:.0f} KB, storage "
+             "{:.0f} KB, textures {:.0f} KB; {:.0f} draws",
+             w.verts / n, w.uniforms / n, w.indices / n, w.storage / n, w.textures / n,
+             double(w.draws) / double(w.statFrames));
+  }
+  static constexpr const char* CpuNames[2] = {"record (GX thread)", "worker (encode+submit)"};
+  for (int i = 0; i < 2; ++i) {
+    const uint32_t n = g_cpuCount[i].exchange(0);
+    const int64_t ns = g_cpuNs[i].exchange(0);
+    const uint32_t mxUs = g_cpuMaxUs[i].exchange(0);
+    if (n != 0) {
+      Log.info("[gpu timing]   CPU {:<22} {:7.3f} ms/frame (max {:.2f}), {} frames", CpuNames[i],
+               double(ns) * 1e-6 / n, mxUs * 1e-3, n);
+    }
+  }
+  w = Window{};
+  w.startNs = now;
+}
+
+void accumulate(const Slot& slot, const uint64_t* ts, uint64_t frameBegin, uint64_t frameEnd) {
+  if (g_reportSeconds <= 0.f) {
+    return;
+  }
+  auto& w = g_window;
+  const int64_t now = now_ns();
+  if (w.startNs == 0) {
+    w.startNs = now;
+  }
+  ++w.frames;
+  w.gpuNs += frameEnd - frameBegin;
+  w.frameUs.push_back(static_cast<uint32_t>(std::min<uint64_t>((frameEnd - frameBegin) / 1000, UINT32_MAX)));
+  if (g_overflowed.exchange(false)) {
+    ++w.overflowFrames;
+  }
+  std::vector<std::pair<const char*, uint64_t>> open;
+  uint64_t topEnd = 0;
+  for (const auto& event : slot.events) {
+    const uint64_t t = ts[event.query];
+    if (event.kind != EventKind::End) {
+      open.emplace_back(event.name, t);
+      continue;
+    }
+    if (open.empty()) {
+      continue;
+    }
+    const auto [name, begin] = open.back();
+    open.pop_back();
+    if (begin == 0 || t < begin) {
+      continue; // never written (e.g. no encoder timestamps on this backend)
+    }
+    std::string_view key{name}; // "EFB 3" -> "EFB": passes counted by kind, not by their place in the frame
+    while (!key.empty() && (std::isdigit(static_cast<unsigned char>(key.back())) || key.back() == ' ')) {
+      key.remove_suffix(1);
+    }
+    auto& total = w.names[std::string{key.empty() ? std::string_view{name} : key}];
+    total.ns += t - begin;
+    ++total.count;
+    if (open.empty()) { // top level: busy time without the gaps between passes, nested time not counted twice
+      w.busyNs += t - std::max(begin, topEnd);
+      topEnd = std::max(topEnd, t);
+    }
+  }
+  if (double(now - w.startNs) * 1e-9 >= g_reportSeconds) {
+    report_window(now);
+  }
+}
