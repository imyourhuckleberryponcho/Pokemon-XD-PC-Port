diff --git a/lib/gfx/frame.cpp b/lib/gfx/frame.cpp
index 82e25ea..bce897c 100644
--- a/lib/gfx/frame.cpp
+++ b/lib/gfx/frame.cpp
@@ -53,6 +53,29 @@ uint32_t g_frameIndex = UINT32_MAX;
 
 std::array<FramePacket, FrameSlotCount> g_framePackets;
 uint64_t g_nextFrameId = 1;
+
+// Finished frame packets (their textures, views, bind groups...) are handed back to the thread that records
+// frames and freed there, at its next end_frame, instead of on the render worker: freeing GPU objects on the
+// worker while the GX command processor creates others crashed inside Dawn, even with implicit device
+// synchronization (bind group creation reading freed descriptor memory).
+std::mutex g_retiredMutex;
+std::vector<FramePacket> g_retiredPackets;
+
+void retire_packet(FramePacket& packet) {
+  FramePacket dead = std::exchange(packet, {});
+  std::lock_guard lock{g_retiredMutex};
+  g_retiredPackets.push_back(std::move(dead));
+}
+
+void free_retired() {
+  std::vector<FramePacket> dead;
+  {
+    std::lock_guard lock{g_retiredMutex};
+    dead.swap(g_retiredPackets);
+  }
+  dead.clear();
+  render_worker::free_retired();
+}
 render_worker::FrameSlotPool g_frameSlots{FrameSlotCount};
 render_worker::FrameSlotPool g_stagingSlots{StagingBufferCount};
 
@@ -564,6 +587,7 @@ void shutdown() {
   for (auto& packet : g_framePackets) {
     packet = {};
   }
+  free_retired();
   shutdown_recording();
   present::shutdown();
   efb::shutdown();
@@ -669,6 +693,10 @@ bool begin_frame() {
 
