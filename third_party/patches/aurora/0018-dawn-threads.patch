   ZoneScoped;
+  // The GX command processor is idle here (aurora::end_frame drained it), so GPU objects the render worker
+  // is done with are freed while nothing else creates any (see g_retiredPackets).
+  free_retired();
+  expire_cached_bind_groups();
   if (g_cpuFrameStart.time_since_epoch().count() != 0) {
     const auto cpuFrameTime = PresentClock::now() - g_cpuFrameStart;
     update_ema(g_cpuFrameTimeNs, duration_ns(cpuFrameTime));
@@ -705,9 +733,8 @@ void end_frame(EndFrameCallback callback) {
     }
     webgpu::gpu_prof::frame_end();
     webgpu::gpu_prof::after_submit();
-    packet = {};
+    retire_packet(packet); // freed by the recording thread (free_retired)
     g_frameSlots.release(frameSlot);
-    expire_cached_bind_groups();
     map_staging_buffer(stagingSlot, true);
     process_events();
   });
