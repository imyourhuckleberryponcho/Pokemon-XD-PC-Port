+// (patch 0067) A frame's vertex / index / uniform / storage buffer is a fixed-size piece of GPU memory. Pushing past
+// its end used to abort the program (ByteBuffer::resize on a mapped view). Now: the push is refused, the first one
+// (then every 1000th) is logged, a flag says so (take_push_overflow: the draw that needed it is left out), and the
+// range handed back lies inside the buffer (offset 0) so nothing reads or writes outside it.
+// XD_GX_LIMIT_<VERTS|INDICES|UNIFORMS|STORAGE>=<bytes> (tests): the buffer counts as that big.
+namespace {
+bool g_pushOverflow = false;
+uint64_t g_pushOverflowCount = 0;
+size_t buffer_limit(const char* name, size_t capacity) {
+  const char* text = std::getenv(name);
+  if (text == nullptr || *text == 0) {
+    return capacity;
+  }
+  const auto value = static_cast<size_t>(std::strtoull(text, nullptr, 10));
+  return value < capacity ? value : capacity;
+}
+size_t effective_capacity(const ByteBuffer& target, const FramePacket& frame) {
+  static const size_t verts = buffer_limit("XD_GX_LIMIT_VERTS", SIZE_MAX);
+  static const size_t indices = buffer_limit("XD_GX_LIMIT_INDICES", SIZE_MAX);
+  static const size_t uniforms = buffer_limit("XD_GX_LIMIT_UNIFORMS", SIZE_MAX);
+  static const size_t storage = buffer_limit("XD_GX_LIMIT_STORAGE", SIZE_MAX);
+  size_t limit = SIZE_MAX;
+  if (&target == &frame.verts) {
+    limit = verts;
+  } else if (&target == &frame.indices) {
+    limit = indices;
+  } else if (&target == &frame.uniforms) {
+    // (the frame's last pass appends gx::MaxUniformSize bytes of padding: always keep room for it)
+    limit = uniforms;
+    return std::min(limit, target.capacity() - gx::MaxUniformSize);
+  } else if (&target == &frame.storage) {
+    limit = storage;
+  }
+  return std::min(limit, target.capacity());
+}
+const char* buffer_name(const ByteBuffer& target, const FramePacket& frame) {
+  return &target == &frame.verts      ? "vertex"
+         : &target == &frame.indices  ? "index"
+         : &target == &frame.uniforms ? "uniform"
+         : &target == &frame.storage  ? "storage"
+                                      : "texture upload";
+}
+Range refuse_push(const ByteBuffer& target, size_t length, size_t capacity) {
+  g_pushOverflow = true;
+  if (g_pushOverflowCount++ % 1000 == 0) {
