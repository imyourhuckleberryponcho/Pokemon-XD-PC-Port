+// EFB copy set-up written as raw BP registers (games with their own GX layer write these instead of
+// calling GXSetTexCopySrc/Dst and GXCopyTex, which send Aurora's own commands). Used by the next copy
+// trigger only if the game wrote them since the last copy, so Aurora's own copy path is unchanged.
+struct RawCopy {
+  u32 src = 0;  // 0x49: left (bits 0-9), top (10-19)
+  u32 size = 0; // 0x4A: width - 1, height - 1
+  u32 dest = 0; // 0x4B: physical address >> 5
+  bool pending = false;
+} s_rawCopy;
+
+void bp_copy_src(u8, u32 value) noexcept {
+  s_rawCopy.src = value;
+  s_rawCopy.pending = true;
+}
+void bp_copy_size(u8, u32 value) noexcept {
+  s_rawCopy.size = value;
+  s_rawCopy.pending = true;
+}
+void bp_copy_dest(u8, u32 value) noexcept {
+  s_rawCopy.dest = value;
+  s_rawCopy.pending = true;
+}
+
+// The texture format of a copy, from the trigger word as GXSetTexCopyDst packs it: format & 7 in bits
+// 4-6, format bit 3 in bit 3, bits 15-16 = 3 for intensity formats. Z formats aren't in the word: the
+// game switches the EFB to Z24 for them.
+GXTexFmt decode_copy_fmt(u32 value) noexcept {
+  const u32 fmt = reg_get(value, 3, 4) | reg_get(value, 1, 3) << 3;
+  if (g_gxState.pixelFmt == GX_PF_Z24) {
+    switch (fmt) {
+    case 0x0: return GX_CTF_Z4;
+    case 0x1: return GX_TF_Z8;
+    case 0x6: return GX_TF_Z24X8;
+    case 0x9: return GX_CTF_Z8M;
+    case 0xA: return GX_CTF_Z8L;
+    case 0xB: return GX_TF_Z16; // GXSetTexCopyDst writes Z16 as 0xB
+    case 0xC: return GX_CTF_Z16L;
+    default: break;
+    }
+  }
+  if (reg_get(value, 2, 15) == 3) {
+    switch (fmt) {
+    case 0x0: return GX_TF_I4;
+    case 0x1: return GX_TF_I8;
+    case 0x2: return GX_TF_IA4;
+    case 0x3: return GX_TF_IA8;
+    case 0x6: return GX_CTF_YUVA8;
+    default: break;
+    }
+  }
+  switch (fmt) {
+  case 0x0: return GX_CTF_R4;
+  case 0x2: return GX_CTF_RA4;
+  case 0x3: return GX_CTF_RA8;
+  case 0x4: return GX_TF_RGB565;
+  case 0x5: return GX_TF_RGB5A3;
+  case 0x6: return GX_TF_RGBA8;
+  case 0x7: return GX_CTF_A8;
+  case 0x8: return GX_CTF_R8;
+  case 0x9: return GX_CTF_G8;
+  case 0xA: return GX_CTF_B8;
+  case 0xB: return GX_CTF_RG8;
+  case 0xC: return GX_CTF_GB8;
+  default: return GX_TF_RGBA8;
+  }
+}
