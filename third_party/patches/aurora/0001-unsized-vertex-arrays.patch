+// Vertex arrays copied to the GPU this frame, by address, length and contents. Games invalidate the vertex
+// cache (GXInvalidateVtxCache) before most draws, which drops every array's cached copy; copying them all
+// again for each draw overflowed the frame's storage buffer in busy scenes, though the data rarely changes.
+// Unchanged data reuses this frame's copy; changed data (CPU-written vertices) is copied again.
+struct ArrayUploadKey {
+  const void* data;
+  u32 length;
+  u64 hash;
+  bool operator==(const ArrayUploadKey&) const = default;
+};
+struct ArrayUploadKeyHash {
+  size_t operator()(const ArrayUploadKey& k) const noexcept { return static_cast<size_t>(k.hash ^ k.length); }
+};
+std::unordered_map<ArrayUploadKey, gfx::Range, ArrayUploadKeyHash> sArrayUploads;
+
+gfx::Range push_array(const void* data, u32 length) {
+  const ArrayUploadKey key{data, length, xxh3_hash_s(data, length)};
+  if (const auto it = sArrayUploads.find(key); it != sArrayUploads.end()) {
+    return it->second;
+  }
+  const auto range = gfx::push_storage(static_cast<const uint8_t*>(data), length);
+  sArrayUploads.emplace(key, range);
+  return range;
+}
