+// Arrays set with GX_ARRAY_SIZE_UNKNOWN: upload as much as this draw's indices reach. Returns true if
+// an upload changed (the draw then can't be merged into the previous one, which used the old upload).
+static bool upload_unsized_arrays(GXVtxFmt fmt, const u8* vtx, u16 vtxCount, u32 vtxSize) noexcept {
+  bool changed = false;
+  const auto& vtxFmt = g_gxState.vtxFmts[fmt];
+  u32 offset = 0;
+  for (int i = GX_VA_PNMTXIDX; i <= GX_VA_TEX7; ++i) {
+    const auto attr = static_cast<GXAttr>(i);
+    const auto& attrFmt = vtxFmt.attrs[i];
+    const auto desc = g_gxState.vtxDesc[i];
+    if (desc == GX_NONE) {
+      continue;
+    }
+    if (desc == GX_DIRECT) {
+      offset += comp_type_size(attr, attrFmt.type) * comp_cnt_count(attr, attrFmt.cnt);
+      continue;
+    }
+    const u32 idxSize = desc == GX_INDEX16 ? 2 : 1;
+    const u32 numIdx = i == GX_VA_NRM && attrFmt.cnt == GX_NRM_NBT3 ? 3 : 1;
+    auto& array = g_gxState.arrays[i];
+    if (array.size == GX_ARRAY_SIZE_UNKNOWN && array.data != nullptr) {
+      const u32 skip = idxSize == 2 ? 0xFFFF : 0xFF; // a position index of all ones skips the vertex
+      u32 maxIdx = 0;
+      bool any = false;
+      for (u32 v = 0; v < vtxCount; ++v) {
+        const u8* p = vtx + v * vtxSize + offset;
+        for (u32 k = 0; k < numIdx; ++k) {
+          const u32 idx = idxSize == 2 ? (static_cast<u32>(p[2 * k]) << 8 | p[2 * k + 1]) : p[k];
+          if (i == GX_VA_POS && idx == skip) {
+            continue;
+          }
+          maxIdx = std::max(maxIdx, idx);
+          any = true;
+        }
+      }
+      if (any) {
+        const u32 elemSize = std::max<u32>(comp_type_size(attr, attrFmt.type) * comp_cnt_count(attr, attrFmt.cnt), 1);
+        const u32 need = maxIdx * array.stride + elemSize;
+        if (need > array.cachedRange.size) {
+          array.cachedRange = push_array(array.data, need);
+          changed = true;
+        }
+      }
+    }
+    offset += idxSize * numIdx;
+  }
+  return changed;
+}
