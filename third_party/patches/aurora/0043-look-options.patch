@@ -170,11 +172,54 @@
 
 // END AREA SAMPLER REGION
 
+// FXAA (post-process anti-aliasing): the classic edge-directed blur. Looks at the luma of the four diagonal
+// neighbours, finds the direction of the edge, and averages samples along it; falls back to the shorter blur when
+// the wider one leaves the local luma range. The picture's own texel size is the step.
+fn fxaa_luma(c: vec3<f32>) -> f32 {
+    return dot(c, vec3<f32>(0.299, 0.587, 0.114));
+}
+
+fn fxaa(uv: vec2<f32>) -> vec3<f32> {
+    let px = vec2<f32>(1.0, 1.0) / vec2<f32>(textureDimensions(t));
+    let rgbNW = textureSampleLevel(t, s, uv + vec2<f32>(-1.0, -1.0) * px, 0.0).rgb;
+    let rgbNE = textureSampleLevel(t, s, uv + vec2<f32>(1.0, -1.0) * px, 0.0).rgb;
+    let rgbSW = textureSampleLevel(t, s, uv + vec2<f32>(-1.0, 1.0) * px, 0.0).rgb;
+    let rgbSE = textureSampleLevel(t, s, uv + vec2<f32>(1.0, 1.0) * px, 0.0).rgb;
+    let rgbM = textureSampleLevel(t, s, uv, 0.0).rgb;
+    let lNW = fxaa_luma(rgbNW);
+    let lNE = fxaa_luma(rgbNE);
+    let lSW = fxaa_luma(rgbSW);
+    let lSE = fxaa_luma(rgbSE);
+    let lM = fxaa_luma(rgbM);
+    let lMin = min(lM, min(min(lNW, lNE), min(lSW, lSE)));
+    let lMax = max(lM, max(max(lNW, lNE), max(lSW, lSE)));
+    if (lMax - lMin < max(0.0312, lMax * 0.125)) {
+        return rgbM; // no edge here
+    }
+    var dir = vec2<f32>(-((lNW + lNE) - (lSW + lSE)), (lNW + lSW) - (lNE + lSE));
+    let dirReduce = max((lNW + lNE + lSW + lSE) * 0.25 * 0.125, 1.0 / 128.0);
+    let rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
+    dir = clamp(dir * rcpDirMin, vec2<f32>(-8.0, -8.0), vec2<f32>(8.0, 8.0)) * px;
+    let rgbA = 0.5 * (textureSampleLevel(t, s, uv + dir * (1.0 / 3.0 - 0.5), 0.0).rgb +
+                      textureSampleLevel(t, s, uv + dir * (2.0 / 3.0 - 0.5), 0.0).rgb);
+    let rgbB = rgbA * 0.5 + 0.25 * (textureSampleLevel(t, s, uv + dir * -0.5, 0.0).rgb +
+                                    textureSampleLevel(t, s, uv + dir * 0.5, 0.0).rgb);
+    let lB = fxaa_luma(rgbB);
+    if (lB < lMin || lB > lMax) {
+        return rgbA;
+    }
+    return rgbB;
+}
