+/**
+ * Frame pacing hooks, called on the render worker for the primary surface: `before` right before a picture is
+ * handed to the window (it may wait, to present at an even rhythm), `after` right after Present returned (for
+ * measuring). Either may be NULL. Keep them short: they run on every present.
+ */
+void aurora_set_present_hooks(void (*before)(void), void (*after)(void));
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/lib/gfx/frame.cpp b/lib/gfx/frame.cpp
index 82e25ea..2baa0f3 100644
--- a/lib/gfx/frame.cpp
+++ b/lib/gfx/frame.cpp
@@ -719,7 +719,19 @@ void gpu_synchronize() { render_worker::synchronize(); }
 
 void synchronize() { render_worker::synchronize(); }
 
+std::atomic<void (*)(void)> g_beforePresentHook{nullptr}; // aurora_set_present_hooks
+std::atomic<void (*)(void)> g_afterPresentHook{nullptr};
+
+void before_present() noexcept {
+  if (const auto hook = g_beforePresentHook.load(std::memory_order_acquire)) {
+    hook();
+  }
+}
+
 void after_present() noexcept {
+  if (const auto hook = g_afterPresentHook.load(std::memory_order_acquire)) {
+    hook();
+  }
   const auto now = PresentClock::now();
   const int64_t nowNs = timestamp_ns(now);
   const int64_t previousPresentNs = g_lastPresentNs.exchange(nowNs, std::memory_order_acq_rel);
@@ -751,3 +763,7 @@ float calculate_fps() noexcept {
 
 const AuroraStats* aurora_get_stats() { return &aurora::gfx::detail::resources().stats; }
 float aurora_get_fps() { return aurora::gfx::calculate_fps(); }
+void aurora_set_present_hooks(void (*before)(void), void (*after)(void)) {
+  aurora::gfx::g_beforePresentHook.store(before, std::memory_order_release);
+  aurora::gfx::g_afterPresentHook.store(after, std::memory_order_release);
+}
