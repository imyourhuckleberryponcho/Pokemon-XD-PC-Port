+# (patch 0047) xxHash's run-time CPU dispatch on x86_64 (AVX2 where present, SSE2 otherwise; same hashes bit for bit).
+# AVX-512 is left out on purpose (frequency drops on some processors).
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|x86_64|x64|X64)$")
+  FetchContent_GetProperties(xxhash SOURCE_DIR _aurora_xxhash_src)
+  if (_aurora_xxhash_src AND EXISTS "${_aurora_xxhash_src}/xxh_x86dispatch.c")
+    target_sources(aurora_gx PRIVATE "${_aurora_xxhash_src}/xxh_x86dispatch.c")
+    set_source_files_properties("${_aurora_xxhash_src}/xxh_x86dispatch.c" PROPERTIES
+      COMPILE_DEFINITIONS "XXH_DISPATCH_AVX512=0")
+    target_compile_definitions(aurora_gx PUBLIC AURORA_XXH_DISPATCH=1)
+  endif ()
+endif ()
+
 if (AURORA_ENABLE_RMLUI)
     target_sources(aurora_gx PRIVATE
         lib/rmlui/pipeline.cpp
