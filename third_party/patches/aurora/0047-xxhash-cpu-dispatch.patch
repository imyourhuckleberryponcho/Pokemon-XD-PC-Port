 inline HashType xxh3_hash_s(const void* input, size_t len, HashType seed = 0) {
+#ifdef AURORA_XXH_DISPATCH
+  return static_cast<HashType>(XXH3_64bits_withSeed_dispatch(input, len, seed));
+#else
   return static_cast<HashType>(XXH3_64bits_withSeed(input, len, seed));
+#endif
+}
+
+// XXH3 128-bit hash of a larger block (texture contents).
+inline XXH128_hash_t xxh3_128(const void* input, size_t len) {
+#ifdef AURORA_XXH_DISPATCH
+  return XXH3_128bits_dispatch(input, len);
+#else
+  return XXH3_128bits(input, len);
+#endif
 }
 
