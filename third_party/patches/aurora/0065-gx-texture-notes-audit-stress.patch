+// ---------------------------------------------------------------------------------------------------------------------
+// (patch 0065) Which texture is which: a note per texture made (address, format, size, contents hash, TLUT), the textures
+// every draw of the last picture sampled (written into F10's textures.txt: numbers and hashes only, never pixels), and a
+// self-check for tests (XD_TEX_AUDIT=1): at every use the bytes in memory are hashed again, without the memo and without
+// the hash-on-write skip, and compared with the hash the cached picture was made from. A difference means the cache hands
+// out a picture that no longer matches the game's memory ("STALE"), a difference between the hash and the upload at
+// creation means the bytes changed while being read ("TORN"). Costs a second read of every texture used: tests only.
+// ---------------------------------------------------------------------------------------------------------------------
+enum PathKind : uint8_t { PathNone = 0, PathObject = 1, PathContent = 2, PathNew = 3, PathReplacement = 4, PathBound = 5, PathCopy = 6 };
+const char* path_name(uint8_t p) {
+  switch (p) {
+  case PathObject: return "object-cache";
+  case PathContent: return "content-cache";
+  case PathNew: return "new";
+  case PathReplacement: return "replacement";
+  case PathBound: return "still-bound";
+  case PathCopy: return "efb-copy";
+  default: return "?";
+  }
+}
+
+struct TexInfo {
+  const void* addr = nullptr;
+  size_t bytes = 0;
+  u32 width = 0, height = 0, format = 0, mips = 0;
+  XXH128_hash_t hash{};
+  const void* tlutAddr = nullptr;
+  u32 tlutEntries = 0, tlutFormat = 0;
+  XXH128_hash_t tlutHash{};
+  uint64_t createdFrame = 0;
+  u32 texObjId = 0;
+  bool hasTlut = false;
+};
+absl::flat_hash_map<const void*, TexInfo> s_texInfo; // by the picture's handle (decoder thread only)
+uint8_t s_lastPath = PathNone;
+
+bool audit_on() {
+  static const bool on = [] {
+    const char* v = std::getenv("XD_TEX_AUDIT");
+    return v != nullptr && v[0] != '0';
+  }();
+  return on;
+}
+
+struct PicTex {
+  TexInfo info;
+  bool known = false;
+  uint8_t path = PathNone;
+  u32 slot = 0;
+  const void* handle = nullptr;
+  u32 width = 0, height = 0, handleFormat = 0;
+  uint64_t seenFrame = 0;
+};
+struct AuditFail {
+  const char* kind = "";
+  uint8_t path = PathNone;
+  TexInfo info;
+  XXH128_hash_t now{};
+  const void* addr = nullptr;
+  uint64_t frame = 0;
+  bool tlutPart = false;
+};
+std::mutex s_reportMutex;
+std::vector<PicTex> s_curPic, s_lastPic;
+std::vector<AuditFail> s_failRing; // the newest 64
+uint64_t s_auditChecks = 0, s_auditStale = 0, s_auditTorn = 0;
+
+void audit_log(const AuditFail& f) {
+  std::fprintf(stderr,
+               "[texaudit] %s%s frame %llu path %s addr %p (mem offset 0x%zx) %ux%u fmt %u mips %u bytes %zu: made from hash %016llx%016llx at frame %llu, "
+               "memory now %016llx%016llx\n",
+               f.kind, f.tlutPart ? " (palette)" : "", static_cast<unsigned long long>(f.frame), path_name(f.path), f.addr,
+               memdirty::offset_of(f.addr), f.info.width, f.info.height, f.info.format, f.info.mips, f.info.bytes,
+               static_cast<unsigned long long>(f.info.hash.high64), static_cast<unsigned long long>(f.info.hash.low64),
+               static_cast<unsigned long long>(f.info.createdFrame), static_cast<unsigned long long>(f.now.high64),
+               static_cast<unsigned long long>(f.now.low64));
+}
+
+void audit_fail(const char* kind, uint8_t path, const TexInfo& info, XXH128_hash_t now, const void* addr, bool tlutPart) {
+  AuditFail f{kind, path, info, now, addr, s_frameCount, tlutPart};
+  if (kind[0] == 'S') {
+    ++s_auditStale;
+  } else {
+    ++s_auditTorn;
+  }
+  if (s_auditStale + s_auditTorn <= 400) {
+    audit_log(f);
+  }
+  std::lock_guard lock{s_reportMutex};
+  if (s_failRing.size() >= 64) {
+    s_failRing.erase(s_failRing.begin());
+  }
+  s_failRing.push_back(f);
+}
+
+bool same_hash(const XXH128_hash_t& a, const XXH128_hash_t& b) noexcept { return a.low64 == b.low64 && a.high64 == b.high64; }
+
+TexInfo make_info(const GXTexObj_& obj, const GXTlutObj_* tlut, const TextureKeys& keys) {
+  TexInfo i;
+  i.addr = obj.data;
+  i.bytes = texture::texture_source_size(obj.format(), obj.width(), obj.height(), obj.mip_count());
+  i.width = obj.width();
+  i.height = obj.height();
+  i.format = obj.format();
+  i.mips = obj.mip_count();
+  i.hash = keys.contentKey.textureHash;
+  i.createdFrame = s_frameCount;
+  i.texObjId = obj.texObjId;
+  if (tlut != nullptr) {
+    i.hasTlut = true;
+    i.tlutAddr = tlut->data;
+    i.tlutEntries = tlut->numEntries;
+    i.tlutFormat = static_cast<u32>(tlut->format);
+    i.tlutHash = keys.contentKey.tlutHash;
+  }
+  return i;
+}
+
+void note_texture(const gfx::TextureHandle& handle, const TexInfo& info) {
+  if (!handle) {
+    return;
+  }
+  if (s_texInfo.size() >= 20000) {
+    s_texInfo.clear();
+  }
+  s_texInfo[handle.get()] = info;
+}
+
+// Check what the cache handed out against the memory now (XD_TEX_AUDIT=1).
+void audit_use(const GXTexObj_& obj, const GXTlutObj_* tlut, const gfx::TextureHandle& handle, uint8_t path) {
+  if (!audit_on() || !handle || path == PathReplacement) {
+    return;
+  }
+  const auto it = s_texInfo.find(handle.get());
+  if (it == s_texInfo.end()) {
+    return;
+  }
+  const TexInfo& info = it->second;
+  ++s_auditChecks;
+  if (info.width != obj.width() || info.height != obj.height() || info.format != obj.format()) {
+    audit_fail("STALE-SHAPE", path, info, {}, obj.data, false);
+    return;
+  }
+  const size_t bytes = texture::texture_source_size(obj.format(), obj.width(), obj.height(), obj.mip_count());
+  const XXH128_hash_t now = aurora::xxh3_128(obj.data, bytes);
+  if (!same_hash(now, info.hash)) {
+    audit_fail("STALE", path, info, now, obj.data, false);
+  }
+  if (tlut != nullptr && info.hasTlut) {
+    const XXH128_hash_t tnow = aurora::xxh3_128(tlut->data, texture::tlut_source_size(tlut->numEntries));
+    if (!same_hash(tnow, info.tlutHash)) {
+      audit_fail("STALE", path, info, tnow, tlut->data, true);
+    }
+  }
+}
+
+// Right after a picture was made from the bytes: were they still the ones that were hashed?
+void audit_made(const GXTexObj_& obj, const GXTlutObj_* tlut, const gfx::TextureHandle& handle, const TexInfo& info) {
+  if (!audit_on() || !handle) {
+    return;
+  }
+  ++s_auditChecks;
+  const XXH128_hash_t now = aurora::xxh3_128(obj.data, info.bytes);
+  if (!same_hash(now, info.hash)) {
+    audit_fail("TORN", PathNew, info, now, obj.data, false);
+  }
+  if (tlut != nullptr) {
+    const XXH128_hash_t tnow = aurora::xxh3_128(tlut->data, texture::tlut_source_size(tlut->numEntries));
+    if (!same_hash(tnow, info.tlutHash)) {
+      audit_fail("TORN", PathNew, info, tnow, tlut->data, true);
+    }
+  }
+}
+
+void note_sampled(u32 slot, const GXTexObj_& obj, const gfx::TextureHandle& handle, uint8_t path) {
+  if (!handle) {
+    return;
+  }
+  PicTex t;
+  t.handle = handle.get();
+  t.slot = slot;
+  t.path = path;
+  t.width = handle->size.width;
+  t.height = handle->size.height;
+  t.handleFormat = handle->gxFormat;
+  t.seenFrame = s_frameCount;
+  if (const auto it = s_texInfo.find(handle.get()); it != s_texInfo.end()) {
+    t.info = it->second;
+    t.known = true;
+  } else {
+    t.info.addr = obj.data;
+    t.info.texObjId = obj.texObjId;
+  }
+  std::lock_guard lock{s_reportMutex};
+  if (s_curPic.size() < 600) {
+    for (const auto& e : s_curPic) {
+      if (e.handle == t.handle && e.slot == t.slot) {
+        return;
+      }
+    }
+    s_curPic.push_back(std::move(t));
+  }
 }
