+// F10: what the last picture sampled, as text: addresses, formats, sizes, hashes, ages. No pixels.
+void write_texture_report(const char* path) {
+  std::vector<PicTex> pic;
+  std::vector<AuditFail> fails;
+  {
+    std::lock_guard lock{s_reportMutex};
+    pic = s_lastPic.empty() ? s_curPic : s_lastPic;
+    fails = s_failRing;
+  }
+  std::FILE* f = std::fopen(path, "wb");
+  if (f == nullptr) {
+    return;
+  }
+  std::fprintf(f,
+               "textures of the last picture (numbers and hashes only, no pixels). frame %llu\r\n"
+               "tracking: hash-on-write %s, self-check (XD_TEX_AUDIT) %s\r\n"
+               "caches: %llu pictures / %llu bytes in the content cache, object cache %llu, texture notes %llu\r\n"
+               "self-check totals: %llu checks, %llu STALE, %llu TORN\r\n\r\n",
+               static_cast<unsigned long long>(s_frameCount),
+               dirty_mode() == DirtyMode::Off ? "off" : (dirty_mode() == DirtyMode::Verify ? "verify" : "on"), audit_on() ? "on" : "off",
+               static_cast<unsigned long long>(s_contentCache.cached_count()),
+               static_cast<unsigned long long>(s_contentCache.cached_bytes()),
+               static_cast<unsigned long long>(s_textureObjectCaches.size()), static_cast<unsigned long long>(s_texInfo.size()),
+               static_cast<unsigned long long>(s_auditChecks), static_cast<unsigned long long>(s_auditStale),
+               static_cast<unsigned long long>(s_auditTorn));
+  std::fprintf(f, "slot path           handle           memory offset  fmt  size      mips hash(texture)                     palette(offset/entries/fmt/hash)                 age(frames) object\r\n");
+  for (const auto& t : pic) {
+    const TexInfo& i = t.info;
+    const size_t off = i.addr != nullptr ? memdirty::offset_of(i.addr) : SIZE_MAX;
+    char offs[32];
+    if (off == SIZE_MAX) {
+      std::snprintf(offs, sizeof offs, "outside");
+    } else {
+      std::snprintf(offs, sizeof offs, "0x%07zx", off);
+    }
+    if (t.known) {
+      char pal[120] = "-";
+      if (i.hasTlut) {
+        const size_t toff = memdirty::offset_of(i.tlutAddr);
+        std::snprintf(pal, sizeof pal, "0x%07zx/%u/%u/%016llx%016llx", toff == SIZE_MAX ? 0 : toff, i.tlutEntries, i.tlutFormat,
+                      static_cast<unsigned long long>(i.tlutHash.high64), static_cast<unsigned long long>(i.tlutHash.low64));
+      }
+      std::fprintf(f, "%-4u %-14s %p %-13s  %-4u %ux%-5u %-4u %016llx%016llx %-52s %-11llu %u\r\n", t.slot, path_name(t.path), t.handle, offs,
+                   i.format, i.width, i.height, i.mips, static_cast<unsigned long long>(i.hash.high64),
+                   static_cast<unsigned long long>(i.hash.low64), pal,
+                   static_cast<unsigned long long>(t.seenFrame >= i.createdFrame ? t.seenFrame - i.createdFrame : 0), i.texObjId);
+    } else {
+      std::fprintf(f, "%-4u %-14s %p %-13s  (not a plain texture: render copy, replacement or unnoted)  %ux%u fmt %u\r\n", t.slot,
+                   path_name(t.path), t.handle, offs, t.width, t.height, t.handleFormat);
+    }
+  }
+  if (!fails.empty()) {
+    std::fprintf(f, "\r\nself-check differences (newest %zu)\r\n", fails.size());
+    for (const auto& x : fails) {
+      std::fprintf(f, "%s%s frame %llu %s offset 0x%zx %ux%u fmt %u made-from %016llx%016llx (frame %llu) now %016llx%016llx\r\n", x.kind,
+                   x.tlutPart ? "(palette)" : "", static_cast<unsigned long long>(x.frame), path_name(x.path), memdirty::offset_of(x.addr),
+                   x.info.width, x.info.height, x.info.format, static_cast<unsigned long long>(x.info.hash.high64),
+                   static_cast<unsigned long long>(x.info.hash.low64), static_cast<unsigned long long>(x.info.createdFrame),
+                   static_cast<unsigned long long>(x.now.high64), static_cast<unsigned long long>(x.now.low64));
+    }
+  }
+  std::fclose(f);
+}
