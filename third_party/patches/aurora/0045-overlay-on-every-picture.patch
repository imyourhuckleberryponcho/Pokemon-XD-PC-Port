+void aurora_overlay_counts(uint32_t* all, uint32_t* withOverlay) {
+#ifdef AURORA_ENABLE_GX
+  aurora::gfx::present::overlay_counts(all, withOverlay);
+#else
+  *all = *withOverlay = 0;
+#endif
+}
+void aurora_hold_overlay(bool on) {
+#ifdef AURORA_ENABLE_GX
+  aurora::imgui::set_overlay_hold(on);
+  if (!on) {
+    aurora::g_heldOverlay = {};
+  }
+#else
+  (void)on;
+#endif
+}
