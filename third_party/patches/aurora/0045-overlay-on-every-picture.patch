 const AuroraEvent* aurora_update();
 bool aurora_begin_frame();
 void aurora_end_frame();
+/* While on, a frame whose own ImGui overlay is empty shows the overlay of the last frame that had one: a game that draws
+ * its overlay once per video field (frame counter, timer) and hands over several pictures in that field (frame rate above
+ * 60: aurora_end_frame called in the middle of the field) has it on every picture, not only the first. Off clears it. */
+void aurora_hold_overlay(bool on);
+/* Testing: pictures handed to the window so far, and how many of them carried the ImGui overlay (the frame rate counter,
+ * the speedrun timer). With the overlay on they must be equal. */
+void aurora_overlay_counts(uint32_t* all, uint32_t* withOverlay);
 
