+// A present of the picture the last display copy made, in the middle of the frame: its own resample (a copy of the
+// XFB as it is now) and its own request, in the order of the frame's operations. The frame's last picture is presented
+// at frame end as always.
+bool present_extra_picture() {
+  gx::fifo::drain();
+  if (!g_recorder.active() || g_recorder.currentRenderPass == UINT32_MAX || g_recorder.inOffscreen) {
+    return false;
+  }
+  auto& frame = current_frame_packet();
+  if (!frame.efb.xfb.state || !g_xfb.view) {
+    return false;
+  }
+  auto& pass = current_render_passes()[g_recorder.currentRenderPass];
+  pass.discardable = false;
+  enqueue_pass(frame, g_recorder.currentRenderPass);
+  auto request = record_present(frame.efb.xfb, g_xfb, true);
+  request.primary = true;
+  frame.presents.push_back(std::move(request));
+  resume_pass_loading(pass);
+  return true;
+}
 
