 namespace aurora::gfx::render_worker {
 namespace {
 constexpr size_t QueueCapacity = 256;
@@ -37,6 +40,51 @@ void complete_sync(const std::shared_ptr<SyncState>& sync) {
   sync->cv.notify_all();
 }
 
+constexpr Module Log{"aurora::gfx::render_worker"};
+
+// The item being run (render_worker::state).
+std::atomic_int g_currentType = -1;
+std::atomic_uint64_t g_currentFrame = 0;
+std::atomic_int64_t g_currentSinceNs = 0;
+std::atomic_uint64_t g_finishedItems = 0;
+
+int64_t steady_ns() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// synchronize(): not for ever. A lost GPU device ends the program with an error instead (as in frame.cpp,
+// SlowWait), and a long wait says what the worker is doing.
+void wait_checking_device(std::unique_lock<std::mutex>& lock, SyncState& sync) {
+  const auto start = std::chrono::steady_clock::now();
+  auto nextReport = start + std::chrono::seconds{5};
+  device_watch::Watch device;
+  while (!sync.cv.wait_for(lock, std::chrono::seconds{1}, [&] { return sync.complete; })) {
+    const auto now = std::chrono::steady_clock::now();
+    const double waited = std::chrono::duration<double>(now - start).count();
+    device.check("the render worker to finish its work", waited);
+    if (now >= nextReport) {
+      nextReport = now + std::chrono::seconds{5};
+      const auto s = state();
+      Log.warn("Waiting {:.0f} s for the render worker to finish its work: it runs {} for {:.0f} ms (frame {}), {} "
+               "pending, {} queued, {} done",
+               waited, item_type_name(s.itemType), s.busyMs, s.frameId, s.pending, s.queued, s.finished);
+    }
+  }
+}
+
+struct CurrentItem {
+  explicit CurrentItem(const QueueItem& item) {
+    g_currentFrame.store(item.frameId, std::memory_order_relaxed);
+    g_currentSinceNs.store(steady_ns(), std::memory_order_relaxed);
+    g_currentType.store(static_cast<int>(item.type), std::memory_order_release);
+  }
+  ~CurrentItem() {
+    g_currentType.store(-1, std::memory_order_release);
+    g_finishedItems.fetch_add(1, std::memory_order_relaxed);
+  }
+};
+
 void worker_main(std::stop_token token) {
   g_workerThreadId = std::this_thread::get_id();
 
@@ -50,6 +98,7 @@ void worker_main(std::stop_token token) {
       continue;
     }
 
+    const CurrentItem current{*item};
     if (item->work) {
       ZoneScopedN("QueueItem work");
       item->work();
@@ -274,6 +323,7 @@ void synchronize() {
       .sync = sync,
   });
   std::unique_lock lock{sync->mutex};
+  wait_checking_device(lock, *sync);
   sync->cv.wait(lock, [&] { return sync->complete; });
 }
 
@@ -289,4 +339,34 @@ bool is_worker_thread() noexcept { return g_workerThreadId == std::this_thread::
 
 bool is_idle() noexcept { return g_pendingItems.load(std::memory_order_acquire) == 0; }
 
+WorkerState state() noexcept {
+  WorkerState s;
+  s.itemType = g_currentType.load(std::memory_order_acquire);
+  s.frameId = g_currentFrame.load(std::memory_order_relaxed);
+  if (s.itemType >= 0) {
+    s.busyMs = static_cast<double>(steady_ns() - g_currentSinceNs.load(std::memory_order_relaxed)) / 1e6;
+  }
+  s.pending = g_pendingItems.load(std::memory_order_acquire);
+  s.queued = g_queue.size();
+  s.finished = g_finishedItems.load(std::memory_order_relaxed);
+  return s;
+}
+
+const char* item_type_name(int type) noexcept {
+  switch (type) {
+  case static_cast<int>(ItemType::BeginFrame):
+    return "begin frame";
+  case static_cast<int>(ItemType::EncodePass):
+    return "encode pass";
+  case static_cast<int>(ItemType::EndFrame):
+    return "end frame (submit, present)";
+  case static_cast<int>(ItemType::Sync):
+    return "sync/work";
+  case static_cast<int>(ItemType::Shutdown):
+    return "shutdown";
+  default:
+    return "nothing (idle)";
+  }
+}
+
 } // namespace aurora::gfx::render_worker
