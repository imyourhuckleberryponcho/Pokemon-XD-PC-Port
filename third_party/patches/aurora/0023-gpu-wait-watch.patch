+
+// A wait for the render worker or the GPU (a frame slot, a staging buffer) that takes seconds is never normal.
+// From 1 s on, the device is checked (without Dawn's lock: device_watch), and a lost one ends the program with
+// the same "Device lost" error as Dawn's own callback, instead of a wait that would never end; every 5 s the
+// wait says what everything is doing.
+struct SlowWait {
+  const char* what;
+  PresentClock::time_point start = PresentClock::now();
+  PresentClock::time_point nextDeviceCheck = start + std::chrono::seconds{1};
+  PresentClock::time_point nextReport = start + std::chrono::seconds{5};
+  device_watch::Watch device;
+
+  void check() {
+    const auto now = PresentClock::now();
+    if (now < nextDeviceCheck) {
+      return;
+    }
+    nextDeviceCheck = now + std::chrono::milliseconds{250};
+    device.check(what, std::chrono::duration<double>(now - start).count());
+    if (now < nextReport) {
+      return;
+    }
+    nextReport = now + std::chrono::seconds{5};
+    const auto worker = render_worker::state();
+    std::string staging;
+    for (size_t i = 0; i < StagingBufferCount; ++i) {
+      staging += fmt::format("{}{}", i ? "," : "", map_state_name(g_mappingStates[i].load(std::memory_order_acquire)));
+    }
+    Log.warn("Waiting {:.0f} s for {}: frame slots free {}/{}, staging free {}/{} ({}); render worker: {} for "
+             "{:.0f} ms (frame {}), {} pending, {} queued, {} done; process-events request {}",
+             std::chrono::duration<double>(now - start).count(), what, g_frameSlots.free_count(), FrameSlotCount,
+             g_stagingSlots.free_count(), StagingBufferCount, staging, render_worker::item_type_name(worker.itemType),
+             worker.busyMs, worker.frameId, worker.pending, worker.queued, worker.finished,
+             g_processEventsQueued.load(std::memory_order_acquire) ? "queued" : "none");
+  }
+};
+
 void pace_frame_start() {
