+// What the worker is doing, for messages about a wait that takes too long (frame.cpp).
+struct WorkerState {
+  int itemType = -1;          // ItemType of the item it is running, -1 = none (waiting for work)
+  uint64_t frameId = 0;       // that item's frame
+  double busyMs = 0.0;        // how long it has been running it
+  size_t pending = 0;         // items enqueued and not finished (running one included)
+  size_t queued = 0;          // items waiting in the queue
+  uint64_t finished = 0;      // items finished since start
+};
+WorkerState state() noexcept;
+const char* item_type_name(int type) noexcept;
+
 } // namespace aurora::gfx::render_worker
