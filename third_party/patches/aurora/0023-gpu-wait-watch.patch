diff --git a/lib/gfx/device_watch.cpp b/lib/gfx/device_watch.cpp
new file mode 100644
index 0000000..9a344fc
--- /dev/null
+++ b/lib/gfx/device_watch.cpp
@@ -0,0 +1,124 @@
+// Is the GPU device still there? Asked by threads that wait for the render worker or the GPU (frame.cpp,
+// SlowWait), without going through Dawn's device lock: when the device is lost while the render worker is
+// inside a Dawn call (waiting for a fence that a reset GPU never signals, a present...), Dawn itself may
+// never get to notice, and a wait for the next frame slot would last forever.
+#include "device_watch.hpp"
+
+#include "render_worker.hpp"
+#include "../internal.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <aurora/gfx.h>
+
+#include <chrono>
+#include <thread>
+
+#include <fmt/format.h>
+
+#include <dawn/native/DawnNative.h>
+
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <dawn/native/D3D12Backend.h>
+#include <dawn/native/D3D11Backend.h>
+#endif
+
+namespace aurora::gfx::device_watch {
+namespace {
+constexpr Module Log{"aurora::gfx"};
+
+#ifdef _WIN32
+const char* hresult_name(HRESULT hr) {
+  switch (static_cast<uint32_t>(hr)) {
+  case 0x887A0005u:
+    return "DXGI_ERROR_DEVICE_REMOVED: the driver was reset or updated, or the graphics card went away";
+  case 0x887A0006u:
+    return "DXGI_ERROR_DEVICE_HUNG: the graphics card stopped responding";
+  case 0x887A0007u:
+    return "DXGI_ERROR_DEVICE_RESET: the graphics card was reset";
+  case 0x887A0020u:
+    return "DXGI_ERROR_DRIVER_INTERNAL_ERROR: the graphics driver failed";
+  case 0x887A0001u:
+    return "DXGI_ERROR_INVALID_CALL";
+  default:
+    return "unknown reason";
+  }
+}
+#endif
+} // namespace
+
+std::string lost_reason() noexcept {
+  const auto& device = webgpu::g_device;
+  if (!device) {
+    return {};
+  }
+  if (dawn::native::IsDeviceLost(device.Get())) {
+    return "Dawn reports the device lost";
+  }
+#ifdef _WIN32
+  HRESULT hr = S_OK;
+  if (webgpu::g_backendType == wgpu::BackendType::D3D12) {
+    if (const auto d3d = dawn::native::d3d12::GetD3D12Device(device.Get())) {
+      hr = d3d->GetDeviceRemovedReason();
+    }
+  } else if (webgpu::g_backendType == wgpu::BackendType::D3D11) {
+    if (const auto d3d = dawn::native::d3d11::GetD3D11Device(device.Get())) {
+      hr = d3d->GetDeviceRemovedReason();
+    }
+  }
+  if (FAILED(hr)) {
+    return fmt::format("the device was removed (0x{:08X} {})", static_cast<uint32_t>(hr), hresult_name(hr));
+  }
+#endif
+  return {};
+}
+
+void Watch::check(const char* waitingFor, double waitedSeconds) {
+  const auto lost = lost_reason();
+  if (lost.empty()) {
+    m_lostSince = -1.0;
+    return;
+  }
+  if (m_lostSince < 0.0) {
+    m_lostSince = waitedSeconds;
+  }
+  const bool dawnKnows = webgpu::g_device && dawn::native::IsDeviceLost(webgpu::g_device.Get());
+  if (waitedSeconds - m_lostSince >= (dawnKnows ? 10.0 : 1.0)) {
+    FATAL("Device lost: {} (found while waiting {:.1f} s for {})", lost, waitedSeconds, waitingFor);
+  }
+}
+
+} // namespace aurora::gfx::device_watch
+
+void aurora_debug_lose_device(bool removeDevice) {
+  using namespace aurora;
+  const auto& device = webgpu::g_device;
+  if (!device) {
+    return;
+  }
+#ifdef _WIN32
+  if (removeDevice && webgpu::g_backendType == wgpu::BackendType::D3D12) {
+    if (const auto d3d = dawn::native::d3d12::GetD3D12Device(device.Get())) {
+      Microsoft::WRL::ComPtr<ID3D12Device5> d3d5;
+      if (SUCCEEDED(d3d.As(&d3d5))) {
+        d3d5->RemoveDevice();
+        return;
+      }
+    }
+  }
+#endif
+  device.ForceLoss(wgpu::DeviceLostReason::Unknown, "aurora_debug_lose_device");
+}
+
+void aurora_debug_stall_render_worker(unsigned seconds) {
+  aurora::gfx::render_worker::enqueue_work([seconds] {
+    if (seconds == 0) {
+      for (;;) {
+        std::this_thread::sleep_for(std::chrono::hours{1});
+      }
+    }
+    std::this_thread::sleep_for(std::chrono::seconds{seconds});
+  });
+}
diff --git a/lib/gfx/device_watch.hpp b/lib/gfx/device_watch.hpp
new file mode 100644
index 0000000..c40cdb8
--- /dev/null
+++ b/lib/gfx/device_watch.hpp
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <string>
+
+namespace aurora::gfx::device_watch {
+// Empty while the GPU device works; else why it doesn't (lost, removed by the driver...). Safe from any
+// thread, also while another thread is blocked inside Dawn.
+std::string lost_reason() noexcept;
+
+// For a thread that waits for the worker or the GPU, called now and then while it waits: ends the program with
+// a "Device lost" error (FATAL) when the device is gone and Dawn's own device-lost callback (which does the
+// same) hasn't, or can't: at once when only the driver knows (Dawn never noticed, e.g. its thread is stuck
+// in the driver), after 10 s when Dawn knows (its callback is then reporting it; one report, not two).
+class Watch {
+public:
+  void check(const char* waitingFor, double waitedSeconds);
+
+private:
+  double m_lostSince = -1.0;
+};
+} // namespace aurora::gfx::device_watch
