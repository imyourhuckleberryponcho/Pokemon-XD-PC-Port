+
+/**
+ * Display lists called from main memory (GX_CMD_CALL_DL) are not part of the command stream the tap sees: the
+ * decoder reads them from the game's memory when it reaches the call. A picture kept and drawn again later would
+ * read whatever the game keeps there NOW (a list it built in a buffer it has freed or reused since: text, pointer
+ * tables, another effect's list). So each called list's bytes are handed to a second tap, in call order, and a replay
+ * takes them from a copy instead of from memory.
+ * AuroraSetCalledListTap: `tap` sees every list run from memory (address, bytes; not while a replay is set). NULL: none.
+ * AuroraSetCalledListReplay: while `lists` is not NULL, a CALL_DL takes its bytes from this array (the next entry at
+ * or after the one used last, with the same address and length; wrapping round once; else from memory as before).
+ * The array must stay valid until it is set to NULL again; call both only with the command stream drained.
+ */
+typedef void (*AuroraCalledListTap)(u32 address, const void* data, u32 length);
+typedef struct {
+  u32 address;
+  u32 length;
+  const void* data;
+} AuroraCalledList;
+void AuroraSetCalledListTap(AuroraCalledListTap tap);
+void AuroraSetCalledListReplay(const AuroraCalledList* lists, u32 count);
 
