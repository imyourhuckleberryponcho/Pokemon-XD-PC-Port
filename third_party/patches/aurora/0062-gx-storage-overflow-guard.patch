+// (patch 0062) Every array an indexed attribute reads has its copy before the draw's vertices are pushed. False when
+// one could not be copied (the storage buffer is full): the draw is then left out as a whole.
+static bool prepare_index_arrays() noexcept {
+  auto& state = g_gxState;
+  for (int i = GX_VA_POS; i <= GX_VA_TEX7; ++i) {
+    if (state.vtxDesc[i] != GX_INDEX8 && state.vtxDesc[i] != GX_INDEX16) {
+      continue;
+    }
+    auto& array = state.arrays[i];
+    if (array.cachedRange.size == 0) {
+      const u32 size = array.size == GX_ARRAY_SIZE_UNKNOWN ? std::max<u32>(array.stride, 4) : array.size;
+      array.cachedRange = push_array(array.data, size);
+      if (sArrayNoRoom) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// The draw is dropped: noted once in a while (the first, then every 1000th).
+static void drop_draw_for_full_storage(u32 totalVtxBytes, ByteReader& reader) noexcept {
+  sArrayNoRoom = false;
+  reader.take(totalVtxBytes);
+  if (sArrayNoRoomDraws++ % 1000 == 0) {
+    Log.warn("A frame's storage buffer is full ({} bytes used): {} draw(s) left out so far", gfx::storage_used(),
+             sArrayNoRoomDraws);
+  }
+}
