+size_t storage_used() noexcept {
+  return g_recorder.active() ? g_recorder.frame().storage.size() : 0;
+}
+
+size_t storage_capacity() noexcept { return StorageBufferSize; }
+
+bool storage_has_room(size_t length) noexcept {
+  if (!g_recorder.active()) {
+    return true; // (push_storage itself says what is wrong then)
+  }
+  const size_t align = static_cast<size_t>(resources().limits.minStorageBufferOffsetAlignment);
+  const size_t begin = AURORA_ALIGN(g_recorder.frame().storage.size(), align != 0 ? align : 1);
+  return begin + length <= StorageBufferSize;
+}
