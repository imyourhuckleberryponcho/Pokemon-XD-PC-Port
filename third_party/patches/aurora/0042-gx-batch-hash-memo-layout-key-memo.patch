 absl::flat_hash_map<ArrayUploadKey, gfx::Range, ArrayUploadKeyHash> sArrayUploads; // (patch 0040: was std::unordered_map, a heap node per new upload)
 
+// (patch 0042) The contents hash of an array is kept for the rest of the command batch being decoded. While a
+// batch is decoded (one top-level process() call) the game is not running (its thread waits in drain(), or the
+// decoder runs on the game's own thread), so the memory the commands point at cannot change; a draw that
+// names the same array again used to hash all of it again. A new batch (process() entered at the top) or a
+// new frame starts again from nothing.
+u64 sArrayHashEpoch = 1;
+struct ArrayHashMemo {
+  const void* data = nullptr;
+  u32 length = 0;
+  u64 epoch = 0;
+  u64 hash = 0;
+};
+std::array<ArrayHashMemo, 256> sArrayHashMemos;
+
+u64 array_hash(const void* data, u32 length) noexcept {
+  const auto slot = static_cast<size_t>((reinterpret_cast<uintptr_t>(data) >> 4) ^ length ^ (length >> 8)) & 255;
+  auto& memo = sArrayHashMemos[slot];
+  if (memo.epoch == sArrayHashEpoch && memo.data == data && memo.length == length) {
+    return memo.hash;
+  }
+  const u64 hash = xxh3_hash_s(data, length);
+  memo = {data, length, sArrayHashEpoch, hash};
+  return hash;
+}
