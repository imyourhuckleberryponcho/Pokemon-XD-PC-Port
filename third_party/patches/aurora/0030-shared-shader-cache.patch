+enum class StoreResult { Stored, Busy, Failed };
+
+// One row in its own transaction (cache_mutex held). Busy: another program holds the database's write lock.
+static StoreResult store_row(const XXH128_hash_t& keyHash, const void* storedValue, sqlite3_uint64 storedValueSize,
+                             size_t valueSize, int compressed) {
+  sqlite::Transaction tx(db, Log, true, true);
+  if (!tx) {
+    if (tx.busy()) {
+      return StoreResult::Busy;
+    }
+    Log.error("Failed to open store transaction");
+    return StoreResult::Failed;
+  }
+
+  check(sqlite3_bind_blob64(store_stmt, 1, &keyHash, sizeof(keyHash), SQLITE_STATIC));
+  check(sqlite3_bind_blob64(store_stmt, 2, storedValue, storedValueSize, SQLITE_STATIC));
+  check(sqlite3_bind_int64(store_stmt, 3, static_cast<sqlite3_int64>(valueSize)));
+  check(sqlite3_bind_int(store_stmt, 4, compressed));
+
+  const auto ret = sqlite3_step(store_stmt);
+  if (ret != SQLITE_DONE) {
+    // Error or something
+    Log.error("Failed to insert row: {}", sqlite3_errmsg(db));
+  }
+  sqlite3_reset(store_stmt);
+  sqlite3_clear_bindings(store_stmt);
+  if (ret != SQLITE_DONE) {
+    return StoreResult::Failed;
+  }
+
+  tx.commit();
+  if (tx) {
+    return StoreResult::Failed; // (the commit failed and said why; rolled back)
+  }
+  cache_keys_used.push_back(keyHash);
+  return StoreResult::Stored;
+}
+
+// Stores the entries that waited for the database, oldest first, until it is busy again (cache_mutex held).
+static void flush_deferred_stores() {
+  if (db == nullptr) {
+    return;
+  }
+  bool busy = false;
+  while (!deferred_stores.empty()) {
+    const auto& entry = deferred_stores.front();
+    const auto result = store_row(entry.keyHash, entry.value.data(), entry.value.size(), entry.valueSize, entry.compressed);
+    if (result == StoreResult::Busy) {
+      busy = true;
+      break;
+    }
+    deferred_stores.pop_front(); // (stored; or failed for another reason, which was logged: not tried again)
+  }
+  deferred_count.store(static_cast<uint32_t>(deferred_stores.size()));
+  if (!busy && deferred_total != 0 && deferred_bursts <= MaxLoggedBursts) {
+    Log.info("Shader cache: the database is free again; all {} entries that waited for it so far are stored{}",
+             deferred_total, deferred_bursts == MaxLoggedBursts ? " (further messages like this are left out)" : "");
+  }
+}
+
+static void deferred_worker() {
+  std::unique_lock lock(cache_mutex);
+  while (true) {
+    deferred_cv.wait(lock, [] { return deferred_stop || !deferred_stores.empty(); });
+    if (deferred_stop) {
+      deferred_thread_running = false;
+      deferred_cv.notify_all();
+      return;
+    }
+    flush_deferred_stores();
+    if (!deferred_stores.empty()) {
+      deferred_cv.wait_for(lock, DeferredRetryInterval, [] { return deferred_stop; });
+    }
+  }
+}
+
+// Keeps an entry the database was too busy to take (cache_mutex held).
+static void defer_store(const XXH128_hash_t& keyHash, const void* storedValue, size_t storedValueSize, size_t valueSize,
+                        int compressed) {
+  if (deferred_stores.empty() && ++deferred_bursts <= MaxLoggedBursts) {
+    Log.warn("Shader cache: the database is busy (another program is using it); new entries wait in memory and are "
+             "stored when it is free");
+  }
+  const auto* bytes = static_cast<const uint8_t*>(storedValue);
+  deferred_stores.push_back({keyHash, std::vector<uint8_t>(bytes, bytes + storedValueSize), valueSize, compressed});
+  deferred_count.store(static_cast<uint32_t>(deferred_stores.size()));
+  ++deferred_total;
+  if (!deferred_thread_running) {
+    deferred_thread_running = true;
+    deferred_stop = false;
+    std::thread(deferred_worker).detach();
+  }
+  deferred_cv.notify_all();
+}
