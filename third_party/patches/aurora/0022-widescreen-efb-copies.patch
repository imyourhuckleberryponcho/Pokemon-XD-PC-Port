+// Widescreen (gx.hpp wide_copy_uv_scale): a wide EFB copy read by a draw kept 4:3 is read as the GameCube's
+// 4:3 copy, its centred part (starting on a whole pixel, as WideMap::map_x). s == 0: the coordinates as is.
+fn wide_copy_uv(uv: vec2f, s: f32, tex: texture_2d<f32>) -> vec2f {{
+  let w = f32(textureDimensions(tex).x);
+  let x = floor((w - w * s) * 0.5) / w + uv.x * s;
+  return select(uv, vec2f(x, uv.y), s != 0.0);
+}}
