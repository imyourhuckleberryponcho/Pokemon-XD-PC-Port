 const gfx::TextureBind& get_texture(GXTexMapID id) noexcept { return g_gxState.textures[static_cast<size_t>(id)]; }
 
+// Widescreen, wide EFB copies (gx.hpp).
+static bool samples_wide_copy(u32 map) noexcept {
+  const u32 id = map & 0xFF;
+  if (id == GX_TEXMAP_NULL || (map & 0x100) != 0 || id >= MaxTextures) {
+    return false;
+  }
+  const void* data = g_gxState.loadedTextures[id].data;
+  if (data == nullptr) {
+    return false;
+  }
+  const auto it = g_gxState.copyTextures.find(data);
+  return it != g_gxState.copyTextures.end() && it->second.wideUvScale > 0.f;
+}
+
+bool wide_copy_stretch_draw() noexcept {
+  const auto& state = g_gxState;
+  if (gfx::efb::wide_aspect() == 0.f || state.projType != GX_ORTHOGRAPHIC) {
+    return false;
+  }
+  if (const auto wide = wide_map(); !wide.on || !wide.full_width(state.logicalViewport.left, state.logicalViewport.width)) {
+    return false;
+  }
+  for (u32 i = 0; i < state.numTevStages; ++i) {
+    if (samples_wide_copy(state.tevStages[i].texMapId)) {
+      return true;
+    }
+  }
+  for (u32 i = 0; i < state.numIndStages; ++i) {
+    if (samples_wide_copy(state.indStages[i].texMapId)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+float wide_copy_uv_scale(const void* data) noexcept {
+  if (gfx::efb::wide_aspect() == 0.f || g_wideStretchDraw || data == nullptr) {
+    return 0.f;
+  }
+  const auto it = g_gxState.copyTextures.find(data);
+  return it != g_gxState.copyTextures.end() ? it->second.wideUvScale : 0.f;
+}
