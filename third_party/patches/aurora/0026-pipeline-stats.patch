+/**
+ * Pipeline (shader) counters since start-up, for measuring first-visit stalls and for a shader preparation step.
+ * skippedDraws: draws left out because their pipeline was still compiling (non-blocking draws).
+ * waits / waitMicros / maxWaitMicros: blocking draws that had to wait for their pipeline, and how long.
+ * knownPipelines: pipeline configurations known (from the cache files and this run).
+ * queued / created: pipelines waiting to be compiled / compiled so far.
+ */
+typedef struct {
+  u64 skippedDraws;
+  u64 waits;
+  u64 waitMicros;
+  u64 maxWaitMicros;
+  u32 knownPipelines;
+  u32 queued;
+  u32 created;
+} AuroraPipelineStats;
+void AuroraGetPipelineStats(AuroraPipelineStats* out);
+
 #if __cplusplus
 }
 #endif
