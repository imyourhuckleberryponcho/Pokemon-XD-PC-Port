+void note_skipped_draw() { ++g_skippedDraws; }
+
 } // namespace aurora::gfx
+
+void AuroraGetPipelineStats(AuroraPipelineStats* out) {
+  using namespace aurora::gfx;
+  if (out == nullptr) {
+    return;
+  }
+  *out = {};
+  out->skippedDraws = g_skippedDraws.load();
+  out->waits = g_pipelineWaits.load();
+  out->waitMicros = g_pipelineWaitMicros.load();
+  out->maxWaitMicros = g_pipelineMaxWaitMicros.load();
+  {
+    std::lock_guard lock{g_pipelineMutex};
+    out->knownPipelines = static_cast<uint32_t>(g_knownPipelines.size());
+  }
+  const AuroraStats* stats = aurora_get_stats();
+  out->queued = stats->queuedPipelines;
+  out->created = stats->createdPipelines;
+}
