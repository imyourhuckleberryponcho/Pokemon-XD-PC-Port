+// GX_TLUT0-15 at 0xC0000 + n * 0x2000, GX_BIGTLUT0-3 at 0xE0000 + n * 0x8000. Aurora's own GXLoadTlut and
+// GXLoadTexObj put the slot number itself there (below 0x200). Returns MaxTluts for anything else.
+u32 tlut_slot_from_tmem(u32 tmem) noexcept {
