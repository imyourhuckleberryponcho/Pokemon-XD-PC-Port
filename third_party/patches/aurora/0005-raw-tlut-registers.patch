+// The register form of a TLUT's address (physical address >> 5 in loadTlut0, BP 0x64), as the GameCube SDK
+// sets it, for games that copy TLUT objects' registers into their own command lists (read in bp_tlut_load).
+void set_tlut_address(GXTlutObj_& obj, const void* data) {
+  if (&MEM1Start != nullptr && MEM1Start != nullptr) {
+    const uintptr_t offset = reinterpret_cast<uintptr_t>(data) - reinterpret_cast<uintptr_t>(MEM1Start);
+    if (offset < 0x1800000) {
+      SET_REG_FIELD(0, obj.loadTlut0, 21, 0, static_cast<u32>(offset >> 5));
+    }
+  }
+}
