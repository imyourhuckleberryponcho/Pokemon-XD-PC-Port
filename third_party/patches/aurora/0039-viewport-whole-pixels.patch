+// A mapped viewport lies on whole pixels, the same pixels map_logical_scissor takes (floor / ceil). With a scale
+// that is not a whole number (the window's own size, e.g. 919 lines for the GameCube's 480) a sub-viewport such as
+// XD's 384x384 shadow map came out with fractional edges: the scissor, the clear and the copy took the whole
+// pixels around it, so the copy's last row and column held only the clear colour, and the ground that samples the
+// copy past its footprint (clamped to its edge) turned black. The small tolerance keeps exact scales (every whole
+// scale, 720 / 900 / 960 lines) exactly as they were.
+gfx::Viewport snap_viewport(const gfx::Viewport& v) noexcept {
+  constexpr float tolerance = 1e-3f;
+  const float left = std::floor(v.left + tolerance);
+  const float top = std::floor(v.top + tolerance);
+  const float right = std::ceil(v.left + v.width - tolerance);
+  const float bottom = std::ceil(v.top + v.height - tolerance);
+  return {
+      .left = left,
+      .top = top,
+      .width = std::max(right - left, 1.f),
+      .height = std::max(bottom - top, 1.f),
+      .znear = v.znear,
+      .zfar = v.zfar,
+  };
+}
