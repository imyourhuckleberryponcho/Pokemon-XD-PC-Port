+// Photo modes: view (3x4, affine) * m (3x4). Without `translate` only view's rotation (normal matrices).
+Mat3x4<float> view_mul(const Mat3x4<float>& view, const Mat3x4<float>& m, bool translate) {
+  const Vec4<float>* v[3] = {&view.m0, &view.m1, &view.m2};
+  const Vec4<float>* r[3] = {&m.m0, &m.m1, &m.m2};
+  Mat3x4<float> out;
+  Vec4<float>* o[3] = {&out.m0, &out.m1, &out.m2};
+  for (int i = 0; i < 3; ++i) {
+    for (int j = 0; j < 4; ++j) {
+      float s = (*v[i])[0] * (*r[0])[j] + (*v[i])[1] * (*r[1])[j] + (*v[i])[2] * (*r[2])[j];
+      if (j == 3 && translate) {
+        s += (*v[i])[3];
+      }
+      (*o[i])[j] = s;
+    }
+  }
+  return out;
+}
+
+// Photo modes: a light (view space) as seen from the new camera: its position moved, its direction turned.
+Light view_light(const Mat3x4<float>& view, Light light) {
+  const Vec4<float>* v[3] = {&view.m0, &view.m1, &view.m2};
+  const Vec4<float> p = light.pos, d = light.dir;
+  for (int i = 0; i < 3; ++i) {
+    light.pos[i] = (*v[i])[0] * p[0] + (*v[i])[1] * p[1] + (*v[i])[2] * p[2] + (*v[i])[3];
+    light.dir[i] = (*v[i])[0] * d[0] + (*v[i])[1] * d[1] + (*v[i])[2] * d[2];
+  }
+  return light;
+}
