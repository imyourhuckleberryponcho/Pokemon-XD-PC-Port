+namespace {
+// Set between frames (after the command stream has been processed), read while processing.
+AuroraViewOverride s_viewOverride{};
+Mat3x4<float> s_overrideView{};
+std::atomic<float> s_overrideFovY{0.f};
+// The perspective projections over a large viewport seen since the override was set, in order of first use.
+constexpr u32 MaxOverrideProjections = 16;
+std::array<AuroraViewProjection, MaxOverrideProjections> s_projections{};
+u32 s_projectionCount = 0;
+u32 s_drawCount = 0;
+
+bool same_projection(const Mat4x4<float>& p, const f32 (&q)[4][4]) noexcept {
+  for (int r = 0; r < 4; ++r) {
+    for (int c = 0; c < 4; ++c) {
+      const float a = p[r][c], b = q[r][c];
+      if (std::fabs(a - b) > 1e-5f * std::max(1.f, std::max(std::fabs(a), std::fabs(b)))) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// Whether the current draw is one the camera applies to: perspective over a large viewport and, with sceneOnly,
+// the scene's own projection (games draw on-screen displays with perspective layers of their own too).
+bool is_scene_draw() noexcept {
+  if (g_gxState.projType != GX_PERSPECTIVE || g_gxState.logicalViewport.width < s_viewOverride.minViewportWidth) {
+    return false;
+  }
+  return !s_viewOverride.sceneOnly || same_projection(g_gxState.proj, s_viewOverride.sceneProj);
+}
+} // namespace
+
+void set_view_override(const AuroraViewOverride* override) noexcept {
+  s_viewOverride = override != nullptr ? *override : AuroraViewOverride{};
+  if (override != nullptr) {
+    const auto& v = override->view;
+    s_overrideView = {{v[0][0], v[0][1], v[0][2], v[0][3]},
+                      {v[1][0], v[1][1], v[1][2], v[1][3]},
+                      {v[2][0], v[2][1], v[2][2], v[2][3]}};
+  }
+  s_projectionCount = 0;
+  s_drawCount = 0;
+}
+
+float view_override_fov_y() noexcept { return s_overrideFovY.load(std::memory_order_relaxed); }
+
+u32 view_override_projections(AuroraViewProjection* out, u32 max) noexcept {
+  const u32 n = std::min(max, s_projectionCount);
+  for (u32 i = 0; i < n; ++i) {
+    out[i] = s_projections[i];
+  }
+  return s_projectionCount;
+}
+
+const Mat3x4<float>* view_override_for_draw(float* zoom) noexcept {
+  if (!s_viewOverride.active || !is_scene_draw()) {
+    return nullptr;
+  }
+  const float p11 = g_gxState.proj.m1[1];
+  if (p11 > 0.f) {
+    s_overrideFovY.store(2.f * std::atan(1.f / p11) * 57.2957795f, std::memory_order_relaxed);
+  }
+  *zoom = s_viewOverride.zoom > 0.f ? s_viewOverride.zoom : 1.f;
+  return &s_overrideView;
+}
+
+bool view_override_hides_draw() noexcept {
+  const auto& state = g_gxState;
+  if (!s_viewOverride.active) {
+    return false;
+  }
+  const u32 order = s_drawCount++;
+  const bool large = state.logicalViewport.width >= s_viewOverride.minViewportWidth;
+  if (large && state.projType == GX_PERSPECTIVE) {
+    u32 i = 0;
+    for (; i < s_projectionCount; ++i) {
+      if (same_projection(state.proj, s_projections[i].proj)) {
+        break;
+      }
+    }
+    if (i == s_projectionCount && i < MaxOverrideProjections) {
+      auto& p = s_projections[s_projectionCount++];
+      for (int r = 0; r < 4; ++r) {
+        for (int c = 0; c < 4; ++c) {
+          p.proj[r][c] = state.proj[r][c];
+        }
+      }
+      p.draws = 0;
+      p.firstDraw = order;
+    }
+    if (i < MaxOverrideProjections) {
+      s_projections[i].draws++;
+    }
+  }
+  // 2D to hide: orthographic, or another perspective layer than the scene's, sampling a texture that isn't an EFB
+  // copy, over a large viewport.
+  if (!s_viewOverride.hide2D || !large || (state.projType == GX_PERSPECTIVE && is_scene_draw())) {
+    return false;
+  }
+  for (u32 i = 0; i < state.numTevStages; ++i) {
+    const auto map = state.tevStages[i].texMapId;
+    if ((map & 0xFF) == GX_TEXMAP_NULL || (map & 0x100) != 0 || (map & 0xFF) >= MaxTextures) {
+      continue;
+    }
+    const void* data = state.loadedTextures[map & 0xFF].data;
+    if (data != nullptr && !state.copyTextures.contains(data)) {
+      return true;
+    }
+  }
+  return false;
+}
 } // namespace aurora::gx
