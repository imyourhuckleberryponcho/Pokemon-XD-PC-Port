+// Widescreen (AuroraSetWidescreen): while the main EFB is wider than the logical picture, a viewport that
+// spans the whole logical width is stretched over the whole EFB and its projection's x row is scaled by
+// `projScale` (3D shows more at the sides; 2D keeps its proportions, centred). Everything narrower (a
+// sub-viewport, scissor edges inside the picture, a part of the EFB copied out) keeps its 4:3 place and size
+// inside the centred 4:3 area, so pictures drawn for copying come out as on the GameCube.
+struct WideMap {
+  bool on = false;
+  float logicalWidth = 0.f;
+  float targetWidth = 0.f;
+  float scaleX = 1.f; // target pixels per logical unit across the whole width
+  float scaleY = 1.f; // target pixels per logical unit in the 4:3 area (and vertically)
+  float projScale = 1.f;
+  // (The 4:3 area starts on a whole pixel, so copies of a part of it have exactly the size drawn.)
+  float map_x(float x) const noexcept {
+    return std::floor((targetWidth - logicalWidth * scaleY) * 0.5f) + x * scaleY;
+  }
+  bool full_width(float left, float width) const noexcept {
+    return left <= 0.5f && left + width >= logicalWidth - 0.5f;
+  }
+};
+WideMap wide_map() noexcept;
