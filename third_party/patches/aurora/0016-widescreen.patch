+// holds the wide picture, so it goes back 1:1). Textured art (menu backgrounds) stays 4:3.
+static float wide_read_comp(const u8* p, GXCompType type, u8 frac, bool le) noexcept {
+  const auto u16v = [&](const u8* q) { return le ? static_cast<u16>(q[0] | q[1] << 8) : static_cast<u16>(q[0] << 8 | q[1]); };
+  const float scale = 1.f / static_cast<float>(1u << frac);
+  switch (type) {
+  case GX_U8:
+    return p[0] * scale;
+  case GX_S8:
+    return static_cast<s8>(p[0]) * scale;
+  case GX_U16:
+    return u16v(p) * scale;
+  case GX_S16:
+    return static_cast<s16>(u16v(p)) * scale;
+  case GX_F32:
+  default: {
+    const u32 bits = le ? (p[0] | p[1] << 8 | p[2] << 16 | static_cast<u32>(p[3]) << 24)
+                        : (static_cast<u32>(p[0]) << 24 | p[1] << 16 | p[2] << 8 | p[3]);
+    return std::bit_cast<float>(bits);
+  }
+  }
