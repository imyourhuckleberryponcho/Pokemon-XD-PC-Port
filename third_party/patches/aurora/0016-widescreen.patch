+        return false;
+      }
+      p = static_cast<const u8*>(array.data) + idx * array.stride;
+      le = array.le;
+    }
+    const float x = wide_read_comp(p, posFmt.type, posFmt.frac, le);
+    const float y = wide_read_comp(p + compSize, posFmt.type, posFmt.frac, le);
+    const float z = cnt == 3 ? wide_read_comp(p + 2 * compSize, posFmt.type, posFmt.frac, le) : 0.f;
+    const u32 mtx = mtxOffset != UINT32_MAX ? base[mtxOffset] / 3 : state.currentPnMtx;
