+    const float vx = m.m0[0] * x + m.m0[1] * y + m.m0[2] * z + m.m0[3];
+    const float vy = m.m1[0] * x + m.m1[1] * y + m.m1[2] * z + m.m1[3];
+    const float vz = m.m2[0] * x + m.m2[1] * y + m.m2[2] * z + m.m2[3];
+    const auto& pr = state.proj.m0;
+    const float ndcX = pr[0] * vx + pr[1] * vy + pr[2] * vz + pr[3];
+    minX = std::min(minX, ndcX);
+    maxX = std::max(maxX, ndcX);
+  }
+  return minX <= -0.99f && maxX >= 0.99f;
+}
