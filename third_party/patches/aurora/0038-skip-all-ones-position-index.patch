diff --git a/lib/gx/command_processor.cpp b/lib/gx/command_processor.cpp
--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -791,6 +791,52 @@ static void draw_prim(GXPrimitive prim, GXVtxFmt fmt, u16 vtxCount, ByteReader&
     UNLIKELY { vtxSize = calc_vtx_size(fmt); }
 
   u32 totalVtxBytes = vtxCount * vtxSize;
+  // A vertex whose position index is all ones (0xFF / 0xFFFF) is not drawn by the GX hardware: it is dropped
+  // from the primitive and the next vertex takes its place. Drawn as an ordinary vertex, the shader reads array
+  // element 0xFFFF, far past the array. So such vertices are taken out of the stream here and the rest is drawn.
+  if (const auto posDesc = g_gxState.vtxDesc[GX_VA_POS];
+      (posDesc == GX_INDEX8 || posDesc == GX_INDEX16) && vtxSize != 0 && totalVtxBytes <= reader.remaining()) {
+    u32 posOff = 0;
+    for (int i = GX_VA_PNMTXIDX; i < GX_VA_POS; ++i) {
+      const auto d = g_gxState.vtxDesc[i];
+      if (d == GX_DIRECT) {
+        const auto attr = static_cast<GXAttr>(i);
+        const auto& af = g_gxState.vtxFmts[fmt].attrs[i];
+        posOff += comp_type_size(attr, af.type) * comp_cnt_count(attr, af.cnt);
+      } else if (d == GX_INDEX8) {
+        ++posOff;
+      } else if (d == GX_INDEX16) {
+        posOff += 2;
+      }
+    }
+    const bool wide = posDesc == GX_INDEX16;
+    const u8* src = reader.data() + reader.offset();
+    auto skipped = [&](u16 v) {
+      const u8* p = src + static_cast<size_t>(v) * vtxSize + posOff;
+      return wide ? (p[0] == 0xFF && p[1] == 0xFF) : p[0] == 0xFF;
+    };
+    u16 kept = 0;
+    for (u16 v = 0; v < vtxCount; ++v) {
+      kept += skipped(v) ? 0 : 1;
+    }
+    if (kept != vtxCount) {
+      static std::vector<u8> compact;
+      compact.clear();
+      compact.reserve(static_cast<size_t>(kept) * vtxSize);
+      for (u16 v = 0; v < vtxCount; ++v) {
+        if (!skipped(v)) {
+          compact.insert(compact.end(), src + static_cast<size_t>(v) * vtxSize,
+                         src + static_cast<size_t>(v + 1) * vtxSize);
+        }
+      }
+      reader.take(totalVtxBytes);
+      if (kept != 0) {
+        ByteReader sub(compact.data(), compact.size()); // (no all-ones index left: the nested call keeps it as is)
+        draw_prim(prim, fmt, kept, sub);
+      }
+      return;
+    }
+  }
   // Widescreen: a full-screen layer is stretched (wide_stretch_draw); a change can't merge with the last draw.
   if (const bool stretch = gfx::efb::wide_aspect() != 0.f && totalVtxBytes <= reader.remaining() &&
                            wide_stretch_draw(fmt, reader.data() + reader.offset(), vtxCount, vtxSize);
