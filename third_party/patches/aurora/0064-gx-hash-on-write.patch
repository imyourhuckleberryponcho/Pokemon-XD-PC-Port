--- /dev/null
+++ b/lib/gx/mem_dirty.hpp
@@ -0,0 +1,61 @@
+#pragma once
+
+// (patch 0064) Which parts of the game's main memory may have changed since a moment: "hash on write".
+//
+// The GameCube's graphics chip only sees what the processor wrote after the game flushed it (DCFlushRange / DCStoreRange /
+// DCStoreRangeNoSync), a texture changed at an address already used needs GXInvalidateTexAll, and the other writers of
+// memory (disc reads, ARAM -> main copies, the movie decoder) are the port's own code. Each of them calls mark() after
+// it wrote. The texture cache (texture.cpp) then keeps a texture's contents hash and reads the bytes again only when a
+// mark touched them since the hash was made (or when the texture is new to it, or lies outside tracked memory).
+//
+// Exactness: a stamp is taken BEFORE the bytes are hashed; a mark made while hashing, or later, has a larger stamp, so the
+// entry counts as dirty. Marks are made AFTER the write. Blocks of 256 bytes; every mark only ever raises a block's stamp,
+// so a rough mark can only cause an extra re-hash, never a missed one. Memory outside main memory is "not tracked": the
+// caller hashes it every time, as before.
+//   XD_TEX_DIRTY=0 off (every texture read for its hash, as before) | 1 on | verify (hashes anyway, reports any change
+//   no mark announced: "[texdirty] MISS ...")
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace aurora::memdirty {
+
+constexpr unsigned kShift = 8;                       // 256-byte blocks
+constexpr size_t kMemBytes = 0x1800000;              // MEM1: 24 MB
+constexpr size_t kSlots = kMemBytes >> kShift;
+
+enum Tag : uint8_t {
+  TagNone = 0,
+  TagCacheFlush = 1,   // DCFlushRange / DCStoreRange
+  TagCacheNoSync = 2,  // ... NoSync
+  TagInvalidate = 3,   // DCInvalidateRange (the game says: something else wrote here)
+  TagZero = 4,         // DCZeroRange
+  TagLockedCache = 5,  // LCStoreData / LCStoreBlocks
+  TagDisc = 6,         // DVD read finished
+  TagAram = 7,         // ARAM -> main memory
+  TagMovie = 8,        // THP decoder output
+  TagTexAll = 9,       // GXInvalidateTexAll
+  TagPort = 10,        // other port code (AuroraMemDirty)
+};
+
+extern std::atomic<uint64_t> g_seq;    // last stamp handed out
+extern std::atomic<uint64_t> g_floor;  // stamp of the last "everything changed"
+extern std::atomic<uint64_t> g_slots[kSlots];
+extern uint8_t g_tags[kSlots];         // who marked a block last (for the verify report)
+
+// Where is `p` in main memory (cached or uncached view)? Offset into it, or SIZE_MAX.
+size_t offset_of(const void* p) noexcept;
+
+void mark(const void* p, size_t n, Tag tag) noexcept;
+void mark_all() noexcept;
+
+inline uint64_t now() noexcept { return g_seq.load(std::memory_order_seq_cst); }
+
+// True when [p, p+n) is in tracked memory and no mark touched it with a stamp above `since`.
+bool clean_since(const void* p, size_t n, uint64_t since) noexcept;
+bool tracked(const void* p, size_t n) noexcept;
+// The newest mark in the range: its stamp and writer (verify report); 0 if none.
+uint64_t newest_mark(const void* p, size_t n, uint8_t* tagOut) noexcept;
+
+} // namespace aurora::memdirty
