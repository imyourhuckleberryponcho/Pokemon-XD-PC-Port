+// (patch 0064) Hash on write (lib/gx/mem_dirty.hpp): the contents hash of a texture / palette is kept for the next pictures
+// as long as no write to its memory was announced (cache flushes, disc reads, ARAM copies, the movie decoder,
+// GXInvalidateTexAll). XD_TEX_DIRTY=0 reads every texture's bytes for the hash again (the old way), =verify does that
+// anyway and reports each texture whose bytes changed with no announcement ("[texdirty] MISS ...").
+enum class DirtyMode { Off, On, Verify };
+DirtyMode dirty_mode() {
+  static const DirtyMode mode = [] {
+    const char* v = std::getenv("XD_TEX_DIRTY");
+    if (v == nullptr) {
+      return DirtyMode::On; // (default on: PERFORMANCE.md section 17; XD_TEX_DIRTY=0 = the old way)
+    }
+    if (std::strcmp(v, "verify") == 0) {
+      return DirtyMode::Verify;
     }
+    return v[0] == '0' ? DirtyMode::Off : DirtyMode::On;
+  }();
+  return mode;
+}
