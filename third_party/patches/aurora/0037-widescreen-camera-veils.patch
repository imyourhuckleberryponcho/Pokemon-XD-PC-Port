diff --git a/lib/gx/command_processor.cpp b/lib/gx/command_processor.cpp
--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -438,6 +438,9 @@
 // positions are read (as the vertex shader will: position matrix, then projection) and must reach both
 // sides of the logical picture; the draw must be untextured or sample only EFB copies (a full-width copy
 // holds the wide picture, so it goes back 1:1). Textured art (menu backgrounds) stays 4:3.
+// Also a camera-facing veil: a PERSPECTIVE, blended draw of at most 8 vertices whose projected corners fit the
+// whole 4:3 view exactly (x and y both -1..1 after the divide by w; the sunlight glow of Sunny Day is one). Its
+// projection is not squeezed to the 4:3 area then, so it covers the wide picture too (patch 0037).
 static float wide_read_comp(const u8* p, GXCompType type, u8 frac, bool le) noexcept {
   const auto u16v = [&](const u8* q) { return le ? static_cast<u16>(q[0] | q[1] << 8) : static_cast<u16>(q[0] << 8 | q[1]); };
   const float scale = 1.f / static_cast<float>(1u << frac);
@@ -461,14 +464,16 @@
 
 static bool wide_stretch_draw(GXVtxFmt fmt, const u8* vtx, u16 vtxCount, u32 vtxSize) noexcept {
   const auto& state = g_gxState;
-  if (state.projType != GX_ORTHOGRAPHIC || vtxCount == 0 || vtxCount > 64) {
+  const bool persp = state.projType == GX_PERSPECTIVE;
+  if ((state.projType != GX_ORTHOGRAPHIC && !persp) || vtxCount == 0 || vtxCount > 64 ||
+      (persp && (vtxCount > 8 || state.blendMode != GX_BM_BLEND))) {
     return false;
   }
   const auto wide = wide_map();
   if (!wide.on || !wide.full_width(state.logicalViewport.left, state.logicalViewport.width)) {
     return false;
   }
-  for (u32 i = 0; i < state.numTevStages; ++i) {
+  for (u32 i = 0; i < state.numTevStages && !persp; ++i) {
     const auto map = state.tevStages[i].texMapId;
     if ((map & 0xFF) == GX_TEXMAP_NULL || (map & 0x100) != 0 || (map & 0xFF) >= MaxTextures) {
       continue;
@@ -512,7 +517,7 @@
   const u32 compSize = comp_type_size(GX_VA_POS, posFmt.type);
   const auto posDesc = state.vtxDesc[GX_VA_POS];
   const auto& array = state.arrays[GX_VA_POS];
-  float minX = FLT_MAX, maxX = -FLT_MAX;
+  float minX = FLT_MAX, maxX = -FLT_MAX, minY = FLT_MAX, maxY = -FLT_MAX;
   for (u32 v = 0; v < vtxCount; ++v) {
     const u8* base = vtx + v * vtxSize;
     const u8* p = base + posOffset;
@@ -537,9 +542,28 @@
     const float vy = m.m1[0] * x + m.m1[1] * y + m.m1[2] * z + m.m1[3];
     const float vz = m.m2[0] * x + m.m2[1] * y + m.m2[2] * z + m.m2[3];
     const auto& pr = state.proj.m0;
-    const float ndcX = pr[0] * vx + pr[1] * vy + pr[2] * vz + pr[3];
+    float ndcX = pr[0] * vx + pr[1] * vy + pr[2] * vz + pr[3];
+    float ndcY = 0.f;
+    if (persp) {
+      // (the divide by w; a corner behind the camera: not a veil)
+      const auto& pw = state.proj.m3;
+      const float w = pw[0] * vx + pw[1] * vy + pw[2] * vz + pw[3];
+      if (w < 1e-4f) {
+        return false;
+      }
+      const auto& py = state.proj.m1;
+      ndcX /= w;
+      ndcY = (py[0] * vx + py[1] * vy + py[2] * vz + py[3]) / w;
+    }
     minX = std::min(minX, ndcX);
     maxX = std::max(maxX, ndcX);
+    minY = std::min(minY, ndcY);
+    maxY = std::max(maxY, ndcY);
+  }
+  if (persp) {
+    // (exactly the view: a bigger plane, such as a sky, is real 3D and stays where the camera puts it)
+    return minX <= -0.99f && maxX >= 0.99f && minY <= -0.99f && maxY >= 0.99f && maxX <= 1.02f && minX >= -1.02f &&
+           maxY <= 1.02f && minY >= -1.02f;
   }
   return minX <= -0.99f && maxX >= 0.99f;
 }
