+// The GameCube's EFB holds up to 528 lines, also when the display shows only 480 (NTSC): games render
+// textures into the lines below the picture (XD's 512x512 battle shadow map). Those lines are never shown.
+constexpr uint32_t EfbMaxLines = 528;
+
+uint32_t texture_height(uint32_t visibleHeight, uint32_t baseHeight) {
+  if (baseHeight == 0 || baseHeight >= EfbMaxLines) {
+    return visibleHeight;
+  }
+  return static_cast<uint32_t>(
+      std::ceil(static_cast<double>(visibleHeight) * static_cast<double>(EfbMaxLines) / baseHeight));
+}
+
