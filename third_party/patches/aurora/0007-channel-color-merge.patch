+void GXSetChanAmbColor(GXChannelID id, GXColor color) {
+  CHECK(id >= GX_COLOR0 && id <= GX_COLOR1A1, "bad channel {}", static_cast<int>(id));
+  const u32 idx = (id == GX_COLOR0 || id == GX_ALPHA0 || id == GX_COLOR0A0) ? 0 : 1;
+  const u32 reg = merge_chan_color(__gx->ambColor[idx], id, color);
+  __gx->ambColor[idx] = reg;
+  GX_WRITE_XF_REG(0xA + idx, reg);
   __gx->bpSent = 0;
 }
 
