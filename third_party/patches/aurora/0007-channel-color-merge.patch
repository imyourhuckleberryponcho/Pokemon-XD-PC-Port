+// The channel colour registers hold RGBA in one word (XF 0x100A/0x100B ambient, 0x100C/0x100D material). As in
+// the SDK: GX_COLORn changes only the RGB bytes, GX_ALPHAn only the alpha byte, GX_COLORnAn all four. (Writing the
+// whole word for GX_COLORn/GX_ALPHAn lost the other part: HSD sets a material's RGB, then its alpha separately.)
+static u32 merge_chan_color(u32 reg, GXChannelID id, GXColor color) {
+  const u32 rgba = (static_cast<u32>(color.r) << 24) | (static_cast<u32>(color.g) << 16) |
+                   (static_cast<u32>(color.b) << 8) | static_cast<u32>(color.a);
+  switch (id) {
+  case GX_COLOR0:
+  case GX_COLOR1:
+    return (reg & 0xFFu) | (rgba & 0xFFFFFF00u);
+  case GX_ALPHA0:
+  case GX_ALPHA1:
+    return (reg & 0xFFFFFF00u) | (rgba & 0xFFu);
+  default:
+    return rgba;
   }
-  CHECK(id >= GX_COLOR0 && id <= GX_ALPHA1, "bad channel {}", static_cast<int>(id));
+}
 
