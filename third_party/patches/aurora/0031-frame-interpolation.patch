+// How full the frame being recorded is: the fullest of its vertex, uniform, index and storage buffers (0..1).
+float frame_buffer_use() noexcept {
+  if (!g_recorder.active()) {
+    return 0.f;
+  }
+  const auto& frame = g_recorder.frame();
+  const auto part = [](size_t used, uint64_t size) { return static_cast<float>(used) / static_cast<float>(size); };
+  return std::max({part(frame.verts.size(), VertexBufferSize), part(frame.uniforms.size(), UniformBufferSize),
+                   part(frame.indices.size(), IndexBufferSize), part(frame.storage.size(), StorageBufferSize)});
+}
 
