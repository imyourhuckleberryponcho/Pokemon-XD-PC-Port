+/**
+ * In-between pictures (frame interpolation by replaying a kept picture's commands, see AuroraSetCommandTap).
+ * RECORD: for every draw whose transforms are sent to the GPU, the decoder notes what the draw is (primitive,
+ * vertex layout, vertex arrays, textures, its indices) and its projection and position/normal matrices; a list
+ * per picture (ending at the display copy), the last two whole pictures kept ("previous" and "current").
+ * REPLAY: nothing is noted, the kept lists stay. Each perspective draw processed meanwhile that is also found in
+ * the PREVIOUS picture (same identity, same occurrence; only while both pictures have equally many draws of that
+ * identity, or all of them share one set of transforms) and didn't jump gets its projection and position/normal
+ * matrices blended: previous * (1 - blend) + its own * blend. blend >= 1: nothing is blended (the picture exactly
+ * as its commands say). Everything else (orthographic draws, new objects, jumps) is drawn as its commands say.
+ * Call only when the command stream has been processed (AuroraSaveGXState does that). Nothing changes while OFF.
+ */
+typedef enum {
+  AURORA_INTERP_OFF = 0,
+  AURORA_INTERP_RECORD = 1,
+  AURORA_INTERP_REPLAY = 2,
+} AuroraInterpMode;
+void AuroraInterpSetMode(AuroraInterpMode mode, f32 blend);
+/** The last two whole pictures compared (RECORD): how many transform sets the current one has, how many of them
+ * are perspective, found in the previous picture, changed at all, and changed too much to blend (a cut, a
+ * teleport). `usable`: an in-between picture makes sense (most perspective draws found, something moved, few
+ * jumps). `pictures`: whole pictures recorded so far; `pending`: draws decoded since the last display copy (0: the
+ * EFB holds nothing of the next picture yet). Waits until the commands written so far are processed. */
+typedef struct {
+  u32 pictures;
+  u32 draws;
+  u32 perspective;
+  u32 matched;
+  u32 moved;
+  u32 jumped;
+  u32 pending;
+  GXBool usable;
+} AuroraInterpInfo;
+void AuroraInterpGetInfo(AuroraInterpInfo* out);
+/** Perspective draws blended / drawn as they are in the replay that the last AuroraInterpSetMode call ended. */
+void AuroraInterpGetReplayCounts(u32* blended, u32* plain);
+/** How full the frame being drawn is: the fullest of its vertex, uniform, index and storage buffers (0..1; a
+ * full one stops the program). Before drawing a kept picture again in the same frame. Waits for the commands
+ * written so far. */
+f32 AuroraGetFrameBufferUse(void);
 
