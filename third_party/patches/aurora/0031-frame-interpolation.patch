+// In-between pictures: a * (1 - t) + b * t, element by element.
+template <typename M>
+M interp_mix(const M& a, const M& b, float t) {
+  M out;
+  const float* p = reinterpret_cast<const float*>(&a);
+  const float* q = reinterpret_cast<const float*>(&b);
+  float* o = reinterpret_cast<float*>(&out);
+  for (size_t i = 0; i < sizeof(M) / sizeof(float); ++i) {
+    o[i] = p[i] + (q[i] - p[i]) * t;
+  }
+  return out;
+}
 
