+// ── In-between pictures (AuroraInterpSetMode, GXAurora.h) ───────────────────────────────────────────────
+// Written while commands are decoded (the FIFO worker, or the caller's thread when draining); the mode and
+// the comparison are read and set by the caller only after a drain, so the two never run at once. The
+// comparison's numbers are also behind a lock (they may be asked for at any time).
+namespace {
+struct InterpRecord {
+  u64 id = 0;         // what the draw is + which occurrence of it in the picture
+  u64 identity = 0;   // what the draw is
+  u16 used = 0;       // the position matrices the draw can use (bit per slot)
+  bool perspective = false;
+  InterpTransforms t;
+};
+// All the draws of a picture that look the same to the decoder (one identity): how many, and whether they all had
+// the same transforms (then it doesn't matter which is paired with which).
+struct InterpKind {
+  u32 count = 0;
+  u64 transforms = 0;
+  bool allSame = true;
+};
+struct InterpPicture {
+  std::vector<InterpRecord> records;
+  absl::flat_hash_map<u64, u32> byId;
+  absl::flat_hash_map<u64, InterpKind> kinds; // by identity
+  void clear() {
+    records.clear();
+    byId.clear();
+    kinds.clear();
+  }
+};
+InterpPicture s_interpPictures[3];
+InterpPicture* s_interpBuilding = &s_interpPictures[0];
+InterpPicture* s_interpCurrent = &s_interpPictures[1];
+InterpPicture* s_interpPrevious = &s_interpPictures[2];
+absl::flat_hash_map<u64, u32> s_interpOccurrences; // per picture being decoded: identity -> times seen
+AuroraInterpMode s_interpMode = AURORA_INTERP_OFF;
+float s_interpBlend = 1.f;
+u64 s_interpDraw = 0;
+std::atomic<u32> s_interpPending{0}; // draws decoded since the last display copy (RECORD)
+u32 s_interpBlended = 0, s_interpPlain = 0;         // in the replay going on
+u32 s_interpLastBlended = 0, s_interpLastPlain = 0; // in the replay before the last mode switch
+std::mutex s_interpInfoMutex;
+AuroraInterpInfo s_interpInfo{};
+
+inline const float* flat(const Mat3x4<float>& m) { return reinterpret_cast<const float*>(&m); }
+
+// Compares one draw's transforms in two pictures: 0 the same, 1 changed, 2 changed too much to blend (more than
+// about 35 degrees of turn, or a move of more than a third of its distance from the camera: a cut or a teleport,
+// or two different objects that only look the same to the decoder).
+int interp_compare(const InterpRecord& a, const InterpRecord& b) {
+  int result = 0;
+  if (std::memcmp(&a.t.proj, &b.t.proj, sizeof a.t.proj) != 0) {
+    result = 1;
+    const float* p = reinterpret_cast<const float*>(&a.t.proj);
+    const float* q = reinterpret_cast<const float*>(&b.t.proj);
+    for (int i = 0; i < 16; ++i) {
+      if (std::fabs(p[i] - q[i]) > 0.25f * std::max(std::fabs(p[i]), std::fabs(q[i])) + 1e-3f) {
+        return 2;
+      }
+    }
+  }
+  const u16 used = a.used & b.used;
+  for (u32 slot = 0; slot < MaxPnMtx; ++slot) {
+    if ((used & (1u << slot)) == 0) {
+      continue;
+    }
+    const float* p = flat(a.t.pn[slot].pos);
+    const float* q = flat(b.t.pn[slot].pos);
+    if (std::memcmp(p, q, sizeof(Mat3x4<float>)) == 0) {
+      continue;
+    }
+    result = std::max(result, 1);
+    float turn = 0.f, size = 0.f, move = 0.f, distP = 0.f, distQ = 0.f;
+    for (int r = 0; r < 3; ++r) {
+      for (int c = 0; c < 3; ++c) {
+        const float d = p[r * 4 + c] - q[r * 4 + c];
+        turn += d * d;
+        size += q[r * 4 + c] * q[r * 4 + c];
+      }
+      const float d = p[r * 4 + 3] - q[r * 4 + 3];
+      move += d * d;
+      distP += p[r * 4 + 3] * p[r * 4 + 3];
+      distQ += q[r * 4 + 3] * q[r * 4 + 3];
+    }
+    const float reach = 0.35f * std::sqrt(std::max(distP, distQ)) + 1.f;
+    if (turn > 0.25f * size || move > reach * reach) {
+      return 2;
+    }
+  }
+  return result;
+}
+
+u64 interp_next_id() {
+  const u32 occurrence = s_interpOccurrences[s_interpDraw]++;
+  return xxh3_hash(occurrence, s_interpDraw);
+}
+
+// Draws of one identity are paired by their turn in the picture (first with first...). That is only safe when
+// both pictures have equally many of them, or when in each picture they all share one set of transforms (particles
+// and sprites drawn through the camera's matrix): otherwise one appeared or vanished and the turns no longer say
+// which is which.
+bool interp_pairing_safe(const InterpPicture& previous, const InterpPicture& current, u64 identity) {
+  const auto a = previous.kinds.find(identity);
+  const auto b = current.kinds.find(identity);
+  if (a == previous.kinds.end() || b == current.kinds.end()) {
+    return false;
+  }
+  return a->second.count == b->second.count || (a->second.allSame && b->second.allSame);
+}
+
+void interp_fill(InterpRecord& rec) {
+  const auto& state = g_gxState;
+  rec.perspective = state.projType == GX_PERSPECTIVE;
+  rec.used = state.vtxDesc[GX_VA_PNMTXIDX] != GX_NONE ? static_cast<u16>((1u << MaxPnMtx) - 1)
+                                                      : static_cast<u16>(1u << (state.currentPnMtx % MaxPnMtx));
+  rec.t.proj = state.proj;
+  rec.t.pn = state.pnMtx;
+}
+} // namespace
+
+void interp_set_mode(AuroraInterpMode mode, float blend) noexcept {
+  if (mode == AURORA_INTERP_OFF || (mode == AURORA_INTERP_RECORD && s_interpMode == AURORA_INTERP_OFF)) {
+    for (auto& picture : s_interpPictures) {
+      picture.clear();
+    }
+    std::lock_guard lock{s_interpInfoMutex};
+    s_interpInfo = {};
+  }
+  s_interpMode = mode;
+  s_interpBlend = blend;
+  s_interpOccurrences.clear();
+  s_interpLastBlended = s_interpBlended;
+  s_interpLastPlain = s_interpPlain;
+  s_interpBlended = s_interpPlain = 0;
+  if (mode == AURORA_INTERP_RECORD) {
+    s_interpBuilding->clear(); // (a picture is recorded from its first draw: switch at a picture's end)
+    s_interpPending.store(0, std::memory_order_relaxed);
+  }
+}
+
+bool interp_active() noexcept { return s_interpMode != AURORA_INTERP_OFF; }
+
+void interp_set_draw(u64 identity) noexcept {
+  s_interpDraw = identity;
+  if (s_interpMode == AURORA_INTERP_RECORD) {
+    s_interpPending.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+const InterpTransforms* interp_for_uniform(float* blend) noexcept {
+  if (s_interpMode == AURORA_INTERP_OFF) {
+    return nullptr;
+  }
+  if (s_interpMode == AURORA_INTERP_RECORD) {
+    auto& rec = s_interpBuilding->records.emplace_back();
+    interp_fill(rec);
+    if (s_interpDraw != 0) {
+      rec.id = interp_next_id();
+      rec.identity = s_interpDraw;
+      s_interpBuilding->byId.try_emplace(rec.id, static_cast<u32>(s_interpBuilding->records.size() - 1));
+      u64 transforms = xxh3_hash_s(&rec.t.proj, sizeof(rec.t.proj), rec.used);
+      for (u32 slot = 0; slot < MaxPnMtx; ++slot) {
+        if ((rec.used & (1u << slot)) != 0) {
+          transforms = xxh3_hash_s(&rec.t.pn[slot].pos, sizeof(rec.t.pn[slot].pos), transforms);
+        }
+      }
+      InterpKind& kind = s_interpBuilding->kinds[s_interpDraw];
+      if (kind.count++ == 0) {
+        kind.transforms = transforms;
+      } else if (kind.transforms != transforms) {
+        kind.allSame = false;
+      }
+    }
+    return nullptr;
+  }
+  // REPLAY (of the current picture's commands): the same draw in the previous picture.
+  if (s_interpDraw == 0) {
+    return nullptr;
+  }
+  const u64 id = interp_next_id();
+  if (s_interpBlend >= 1.f || g_gxState.projType != GX_PERSPECTIVE) {
+    return nullptr;
+  }
+  const auto it = s_interpPrevious->byId.find(id);
+  if (it == s_interpPrevious->byId.end() || !interp_pairing_safe(*s_interpPrevious, *s_interpCurrent, s_interpDraw)) {
+    ++s_interpPlain;
+    return nullptr;
+  }
+  const InterpRecord& prev = s_interpPrevious->records[it->second];
+  InterpRecord now;
+  interp_fill(now);
+  if (!prev.perspective || interp_compare(prev, now) != 1) {
+    ++s_interpPlain; // the same (nothing to blend) or a jump
+    return nullptr;
+  }
+  ++s_interpBlended;
+  *blend = s_interpBlend;
+  return &prev.t;
+}
+
+void interp_end_picture() noexcept {
+  if (s_interpMode != AURORA_INTERP_RECORD) {
+    return;
+  }
+  AuroraInterpInfo info{};
+  info.draws = static_cast<u32>(s_interpBuilding->records.size());
+  for (const InterpRecord& rec : s_interpBuilding->records) {
+    if (!rec.perspective) {
+      continue;
+    }
+    ++info.perspective;
+    if (rec.id == 0) {
+      continue;
+    }
+    const auto it = s_interpCurrent->byId.find(rec.id);
+    if (it == s_interpCurrent->byId.end() || !s_interpCurrent->records[it->second].perspective ||
+        !interp_pairing_safe(*s_interpCurrent, *s_interpBuilding, rec.identity)) {
+      continue;
+    }
+    ++info.matched;
+    const int change = interp_compare(s_interpCurrent->records[it->second], rec);
+    if (change == 1) {
+      ++info.moved;
+    } else if (change == 2) {
+      ++info.jumped;
+    }
+  }
+  info.usable = info.moved > 0 && info.matched * 2 >= info.perspective && info.jumped * 4 <= info.matched;
+  std::swap(s_interpPrevious, s_interpCurrent); // previous <- current <- building
+  std::swap(s_interpCurrent, s_interpBuilding);
+  s_interpBuilding->clear();
+  s_interpOccurrences.clear();
+  s_interpPending.store(0, std::memory_order_relaxed);
+  std::lock_guard lock{s_interpInfoMutex};
+  info.pictures = s_interpInfo.pictures + 1;
+  s_interpInfo = info;
+}
+
+void interp_info(AuroraInterpInfo* out) noexcept {
+  std::lock_guard lock{s_interpInfoMutex};
+  *out = s_interpInfo;
+  out->pending = s_interpPending.load(std::memory_order_relaxed);
+}
+
+void interp_replay_counts(u32* blended, u32* plain) noexcept {
+  *blended = s_interpLastBlended;
+  *plain = s_interpLastPlain;
+}
 } // namespace aurora::gx
