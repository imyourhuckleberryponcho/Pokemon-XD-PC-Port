+// set_source_observer: ask the observer about this texture and, if it wants it, hand it the decoded picture.
+void notify_source_observer(const GXTexObj_& obj, const TextureSourceKey& sourceKey) noexcept {
+  if (!s_observerSet.load(std::memory_order_acquire)) {
+    return;
+  }
+  SourceObserver observer;
+  {
+    std::lock_guard lk(s_observerMutex);
+    observer = s_observer;
+  }
+  if (observer.wants == nullptr || observer.decoded == nullptr || !observer.wants(observer.userData, sourceKey) ||
+      !obj.has_data()) {
+    return;
+  }
+  const ArrayRef texData{static_cast<const uint8_t*>(obj.data), UINT32_MAX};
+  gfx::ConvertedTexture pixels;
+  if (gx::is_palette_format(obj.format())) {
+    const GXTlutObj_* tlut = get_loaded_tlut(obj);
+    if (tlut == nullptr) {
+      return;
+    }
+    pixels = gfx::convert_texture_palette(obj.format(), obj.width(), obj.height(), 1, texData, tlut->format,
+                                          tlut->numEntries, tlut_bytes(*tlut));
+  } else {
+    pixels = gfx::convert_texture(obj.format(), obj.width(), obj.height(), 1, texData);
+  }
+  const uint64_t rgbaBytes = gfx::calc_texture_size(wgpu::TextureFormat::RGBA8Unorm, obj.width(), obj.height(), 1);
+  if (pixels.data.empty() || pixels.format != wgpu::TextureFormat::RGBA8Unorm || pixels.data.size() < rgbaBytes) {
+    return;
+  }
+  observer.decoded(observer.userData, sourceKey, pixels.data.data(), obj.width(), obj.height());
+}
