+/// Watches textures as they are resolved, so a program can make replacements from the texture's own picture
+/// (e.g. repaint part of it). While an observer is set, source keys are built for every texture resolved and
+/// `wants` is asked with each; for a key it wants, `decoded` gets the base level as RGBA8 (width * height * 4
+/// bytes) and may register a replacement for that key right away: the lookup that follows finds it. Both run on
+/// whichever thread resolves textures, without Aurora's registry lock held: they must be thread safe and may only
+/// call register_replacement / unregister_replacement(s) of aurora::texture. A null `wants` removes the observer.
+struct SourceObserver {
+  bool (*wants)(void* userData, const TextureSourceKey& key) = nullptr;
+  void (*decoded)(void* userData, const TextureSourceKey& key, const uint8_t* rgba, uint32_t width,
+                  uint32_t height) = nullptr;
+  void* userData = nullptr;
+};
+void set_source_observer(SourceObserver observer);
+
 } // namespace aurora::texture
 
 #endif
