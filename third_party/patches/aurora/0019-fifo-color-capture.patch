+
+GXBool capture_color_in_stream(AuroraReadbackStream stream, u64 key) {
+  if (!valid_stream(stream)) {
+    return reject("invalid capture arguments");
+  }
+  write_header(GX_AURORA_READBACK_CAPTURE_COLOR, stream, 1);
+  fifo::write_u64(key);
+  return GX_TRUE;
+}
+
+void handle_capture_color(ByteReader& reader) {
+  const auto header = read_header(reader);
+  const auto key = reader.read<u64>();
+  if (!gfx::readback::capture_color_at(header.stream, header.sequence, key)) {
+    fail("colour capture: no colour target here");
+  }
 }
 
