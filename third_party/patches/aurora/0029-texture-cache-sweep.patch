diff --git a/lib/gx/texture.cpp b/lib/gx/texture.cpp
index 33a8c99..3d151ad 100644
--- a/lib/gx/texture.cpp
+++ b/lib/gx/texture.cpp
@@ -738,7 +738,12 @@ void end_frame() noexcept {
   s_stats.publishBytes = streamingStats.publishBytes;
   ++s_frameCount;
   apply_pending_invalidations();
-  sweep_object_caches();
+  // Port patch 0029: the sweep walks every texture object seen in the last ObjectCacheIdleFrames frames (tens of
