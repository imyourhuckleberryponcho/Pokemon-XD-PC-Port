diff --git a/lib/dolphin/gx/GXDispList.cpp b/lib/dolphin/gx/GXDispList.cpp
index 5bf9460..59dc079 100644
--- a/lib/dolphin/gx/GXDispList.cpp
+++ b/lib/dolphin/gx/GXDispList.cpp
@@ -7,6 +7,13 @@
 
 static __GXData_struct sSavedGXData;
 
+// Where the game's main memory is (dolphin/os); a weak reference, see lib/gx/regs.cpp.
+#if defined(_MSC_VER)
+extern void* MEM1Start;
+#else
+extern void* MEM1Start __attribute__((weak));
+#endif
+
 extern "C" {
 void GXBeginDisplayList(void* list, u32 size) {
   CHECK(!aurora::gx::fifo::in_display_list(), "Display list began twice!");
@@ -62,4 +69,25 @@ void GXCallDisplayList(const void* data, u32 nbytes) {
   aurora::gx::fifo::publish();
 }
 
+// The hardware's "call display list" command (0x40, address, size) for a list in the game's main memory:
+// the decoder runs the list when it reaches the command (lib/gx/command_processor.cpp), as the chip reads
+// it from memory then. Lists elsewhere are copied in, as GXCallDisplayList does.
+void GXCallDisplayListAt(const void* data, u32 nbytes) {
+  const uintptr_t offset = reinterpret_cast<uintptr_t>(data) - reinterpret_cast<uintptr_t>(MEM1Start);
+  if (&MEM1Start == nullptr || MEM1Start == nullptr || offset >= 0x1800000 || nbytes > 0x1800000 - offset) {
+    GXCallDisplayList(data, nbytes);
+    return;
+  }
+  if (__gx->dirtyState != 0) {
+    __GXSetDirtyState();
+  }
+  if (*reinterpret_cast<u32*>(&__gx->vNum) != 0) {
+    __GXSendFlushPrim();
+  }
+  aurora::gx::fifo::write_u8(GX_CMD_CALL_DL);
+  aurora::gx::fifo::write_u32(0x80000000u | static_cast<u32>(offset));
+  aurora::gx::fifo::write_u32(nbytes);
+  aurora::gx::fifo::publish();
+}
+
 }
