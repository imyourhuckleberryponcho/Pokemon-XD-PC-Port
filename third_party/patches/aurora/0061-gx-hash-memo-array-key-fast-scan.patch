+// (patch 0060) Largest index of `count` vertices `stride` bytes apart, the index being 1 or 2 (big-endian) bytes at
+// `p`; with `skipAllOnes` a vertex whose index is all ones is not counted (a skipped position). Four independent
+// running maxima over unrolled vertices (the older loop was one dependent chain with a branch per vertex); the
+// answer is the same: the largest index over the counted vertices (0 when none) and whether any vertex counted.
+template <bool Two, bool Skip>
+static inline u32 scan_max_index(const u8* p, u32 count, u32 stride, bool& any) noexcept {
+  constexpr u32 skip = Two ? 0xFFFFu : 0xFFu;
+  const auto load = [](const u8* q) noexcept -> u32 { return Two ? (static_cast<u32>(q[0]) << 8 | q[1]) : q[0]; };
+  u32 m0 = 0, m1 = 0, m2 = 0, m3 = 0, counted = 0;
+  u32 v = 0;
+  for (; v + 4 <= count; v += 4, p += 4 * static_cast<size_t>(stride)) {
+    const u32 i0 = load(p), i1 = load(p + stride), i2 = load(p + 2 * static_cast<size_t>(stride)),
+              i3 = load(p + 3 * static_cast<size_t>(stride));
+    if constexpr (Skip) {
+      counted |= static_cast<u32>(i0 != skip) | static_cast<u32>(i1 != skip) | static_cast<u32>(i2 != skip) |
+                 static_cast<u32>(i3 != skip);
+      m0 = std::max(m0, i0 == skip ? 0u : i0);
+      m1 = std::max(m1, i1 == skip ? 0u : i1);
+      m2 = std::max(m2, i2 == skip ? 0u : i2);
+      m3 = std::max(m3, i3 == skip ? 0u : i3);
+    } else {
+      m0 = std::max(m0, i0);
+      m1 = std::max(m1, i1);
+      m2 = std::max(m2, i2);
+      m3 = std::max(m3, i3);
+    }
+  }
+  for (; v < count; ++v, p += stride) {
+    const u32 i = load(p);
+    if constexpr (Skip) {
+      counted |= static_cast<u32>(i != skip);
+      m0 = std::max(m0, i == skip ? 0u : i);
+    } else {
+      m0 = std::max(m0, i);
+    }
+  }
+  any = Skip ? counted != 0 : count != 0;
+  return std::max(std::max(m0, m1), std::max(m2, m3));
+}
