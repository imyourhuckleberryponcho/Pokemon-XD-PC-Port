+// (patch 0060) The contents hash of a texture (or palette) is kept for the rest of the batch being decoded: the
+// game's memory cannot change meanwhile (see command_processor.cpp's array hash memo, patch 0042), and the game
+// makes a new texture object for most uses, so one texture was read in full again at each draw that names it.
+// A new batch asks again: nothing is assumed about memory between batches. fifo::batch_epoch() is 0 outside a
+// batch (then the memo is not used). XD_GX_TEXMEMO=0 turns it off.
+struct SourceHashMemo {
+  const void* data = nullptr;
+  size_t bytes = 0;
+  uint64_t epoch = 0;
+  XXH128_hash_t hash{};
+};
+std::array<SourceHashMemo, 256> s_sourceHashMemos;
+
+XXH128_hash_t hash_source_bytes(const void* data, size_t bytes) {
+  static const bool memoOn = perf::option("XD_GX_TEXMEMO");
+  const bool stats = perf::stats_on();
+  const uint64_t epoch = memoOn ? fifo::batch_epoch() : 0;
+  SourceHashMemo* memo = nullptr;
+  if (epoch != 0) {
+    const auto slot = static_cast<size_t>((reinterpret_cast<uintptr_t>(data) >> 5) ^ bytes ^ (bytes >> 9)) & 255;
+    memo = &s_sourceHashMemos[slot];
+    if (memo->epoch == epoch && memo->data == data && memo->bytes == bytes) {
+      if (stats) {
+        ++perf::g.texMemoHits;
+        perf::g.texMemoBytes += bytes;
+      }
+      return memo->hash;
+    }
+  }
+  const uint64_t t0 = stats ? perf::now_ns() : 0;
+  const XXH128_hash_t hash = aurora::xxh3_128(data, bytes);
+  if (stats) {
+    perf::g.texNs += perf::now_ns() - t0;
+    ++perf::g.texCalls;
+    perf::g.texBytes += bytes;
+    // (what a write watch could skip: the same address and size with the same bytes as the last time it was read)
+    static std::map<std::pair<const void*, size_t>, XXH128_hash_t> seen;
+    auto [it, fresh] = seen.try_emplace({data, bytes}, hash);
+    if (fresh) {
+      ++perf::g.texNew;
+    } else if (it->second.low64 == hash.low64 && it->second.high64 == hash.high64) {
+      ++perf::g.texSameAsBefore;
+      perf::g.texSameBytes += bytes;
+    } else {
+      ++perf::g.texChanged;
+      it->second = hash;
+    }
+  }
+  if (memo != nullptr) {
+    *memo = {data, bytes, epoch, hash};
+  }
+  return hash;
+}
