diff --git a/lib/gx/gx_perf.hpp b/lib/gx/gx_perf.hpp
new file mode 100644
index 0000000..edd94ad
--- /dev/null
+++ b/lib/gx/gx_perf.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+// Test switches and counters for the graphics-command decoding speed work (port patch 0060).
+//   XD_GX_TEXMEMO=0    texture contents are hashed again at every use (the memo for one batch is off)
+//   XD_GX_ARRAYFAST=0  vertex arrays are hashed and shared by content (the by-address-and-batch key is off)
+//   XD_GXHASH_STATS=1  prints what the decoder did, every 600 frames, on stderr
+// Everything is on unless "0" is given. None of it changes a picture.
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+
+namespace aurora::gx::perf {
+
+inline bool option(const char* name) noexcept {
+  const char* v = std::getenv(name);
+  return v == nullptr || v[0] != '0';
+}
+inline bool stats_on() noexcept {
+  static const bool on = std::getenv("XD_GXHASH_STATS") != nullptr;
+  return on;
+}
+inline uint64_t now_ns() noexcept {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+struct Stats {
+  uint64_t frames = 0, batches = 0, processNs = 0;
+  uint64_t texCalls = 0, texBytes = 0, texNs = 0, texMemoHits = 0, texMemoBytes = 0;
+  uint64_t texSameAsBefore = 0, texChanged = 0, texNew = 0, texSameBytes = 0;
+  uint64_t arrCalls = 0, arrHashed = 0, arrHashBytes = 0, arrNs = 0, arrFast = 0, arrFastCopied = 0;
+  uint64_t scanNs = 0, scanVerts = 0;
+};
+inline Stats g;
+
+} // namespace aurora::gx::perf
