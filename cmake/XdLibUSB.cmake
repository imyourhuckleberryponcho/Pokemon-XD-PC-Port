option(XD_LIBUSB "Build SDL with libusb so that Nintendo's GameCube adapter works" ON)
set(XD_LIBUSB_VERSION "1.0.30")
set(XD_LIBUSB_FILE "" CACHE INTERNAL "the libusb library file to put next to the programs")
set(XD_LIBUSB_NAME "" CACHE INTERNAL "its name there")

if (XD_LIBUSB)
  include(FetchContent)
  if (WIN32)
    if (CMAKE_SIZEOF_VOID_P EQUAL 8)
      set(_xd_usb_sub "VS2022/MS64")
    else ()
      set(_xd_usb_sub "VS2022/MS32")
    endif ()
    set(libusb_SOURCE_DIR "${CMAKE_BINARY_DIR}/_deps/libusb-src")
    set(_xd_usb_arc "${CMAKE_BINARY_DIR}/_deps/libusb-${XD_LIBUSB_VERSION}.7z")
    if (NOT EXISTS "${libusb_SOURCE_DIR}/${_xd_usb_sub}/dll/libusb-1.0.dll")
      file(DOWNLOAD "https://github.com/libusb/libusb/releases/download/v${XD_LIBUSB_VERSION}/libusb-${XD_LIBUSB_VERSION}.7z"
        "${_xd_usb_arc}" EXPECTED_HASH SHA256=7fb1dfec805b97983763d7d0ae244320da12add1003d4249c96cc4d586398c79)
      find_program(_xd_7z NAMES 7z 7za HINTS "$ENV{ProgramFiles}/7-Zip" "$ENV{ProgramW6432}/7-Zip")
      if (_xd_7z AND EXISTS "${_xd_usb_arc}")
        execute_process(COMMAND "${_xd_7z}" x -y "-o${libusb_SOURCE_DIR}" "${_xd_usb_arc}"
                        "${_xd_usb_sub}" include COPYING AUTHORS RESULT_VARIABLE _xd_usb_r OUTPUT_QUIET)
      else ()
        message(WARNING "xd: 7-Zip not found: cannot unpack libusb (install 7-Zip); no GameCube adapter support")
      endif ()
    endif ()
  else ()
    FetchContent_Declare(libusb
      URL https://github.com/libusb/libusb/releases/download/v${XD_LIBUSB_VERSION}/libusb-${XD_LIBUSB_VERSION}.tar.bz2
      URL_HASH SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
      DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    if (POLICY CMP0169)
      cmake_policy(SET CMP0169 OLD) # (plain download, no sub-project)
    endif ()
    FetchContent_GetProperties(libusb)
    if (NOT libusb_POPULATED)
      FetchContent_Populate(libusb)
    endif ()
  endif ()
  if (libusb_SOURCE_DIR)
    if (WIN32)
      set(_xd_usb_inc "${libusb_SOURCE_DIR}/include")
      set(_xd_usb_lib "${libusb_SOURCE_DIR}/${_xd_usb_sub}/dll/libusb-1.0.lib")
      set(_xd_usb_dll "${libusb_SOURCE_DIR}/${_xd_usb_sub}/dll/libusb-1.0.dll")
    else ()
      set(_xd_usb_prefix "${CMAKE_BINARY_DIR}/libusb-install")
      if (APPLE)
        set(_xd_usb_lib "${_xd_usb_prefix}/lib/libusb-1.0.a")
      else ()
        set(_xd_usb_lib "${_xd_usb_prefix}/lib/libusb-1.0.so")
      endif ()
      set(_xd_usb_inc "${_xd_usb_prefix}/include")
      if (NOT EXISTS "${_xd_usb_lib}")
        message(STATUS "xd: building libusb ${XD_LIBUSB_VERSION}")
        set(_xd_usb_bd "${CMAKE_BINARY_DIR}/libusb-build")
        file(MAKE_DIRECTORY "${_xd_usb_bd}")
        set(_xd_usb_env "")
        if (APPLE)
          set(_xd_usb_kind --disable-shared --enable-static --with-pic)
        else ()
          set(_xd_usb_kind --enable-shared --disable-static)
        endif ()
        if (APPLE AND CMAKE_OSX_ARCHITECTURES)
          set(_xd_usb_flags "")
          foreach (_a ${CMAKE_OSX_ARCHITECTURES})
            string(APPEND _xd_usb_flags " -arch ${_a}")
          endforeach ()
          set(_xd_usb_env "CFLAGS=-O2${_xd_usb_flags}" "LDFLAGS=${_xd_usb_flags}")
        endif ()
        if (CMAKE_C_COMPILER)
          list(APPEND _xd_usb_env "CC=${CMAKE_C_COMPILER}")
        endif ()
        execute_process(
          COMMAND ${CMAKE_COMMAND} -E env ${_xd_usb_env} "${libusb_SOURCE_DIR}/configure" --prefix=${_xd_usb_prefix}
                  ${_xd_usb_kind} --disable-udev
          WORKING_DIRECTORY "${_xd_usb_bd}" RESULT_VARIABLE _xd_usb_r OUTPUT_FILE "${_xd_usb_bd}/configure.log"
          ERROR_FILE "${_xd_usb_bd}/configure.log")
        if (_xd_usb_r EQUAL 0)
          execute_process(COMMAND make -j4 install WORKING_DIRECTORY "${_xd_usb_bd}" RESULT_VARIABLE _xd_usb_r
                          OUTPUT_FILE "${_xd_usb_bd}/make.log" ERROR_FILE "${_xd_usb_bd}/make.log")
        endif ()
        if (NOT _xd_usb_r EQUAL 0)
          message(WARNING "xd: libusb did not build (see ${_xd_usb_bd}); no GameCube adapter support")
        endif ()
      endif ()
      set(_xd_usb_inc "${_xd_usb_inc}/libusb-1.0")
    endif ()
    if (EXISTS "${_xd_usb_lib}" AND EXISTS "${_xd_usb_inc}/libusb.h")
      set(LibUSB_LIBRARY "${_xd_usb_lib}" CACHE FILEPATH "libusb (XdLibUSB.cmake)" FORCE)
      set(LibUSB_INCLUDE_PATH "${_xd_usb_inc}" CACHE PATH "libusb headers (XdLibUSB.cmake)" FORCE)
      set(SDL_HIDAPI_LIBUSB ON CACHE BOOL "" FORCE)
      if (NOT APPLE)
        set(SDL_HIDAPI_LIBUSB_SHARED ON CACHE BOOL "" FORCE)
      endif ()
      if (WIN32)
        set(XD_LIBUSB_FILE "${_xd_usb_dll}" CACHE INTERNAL "")
        set(XD_LIBUSB_NAME "libusb-1.0.dll" CACHE INTERNAL "")
      else ()
        if (APPLE)
          set(SDL_HIDAPI_LIBUSB_SHARED OFF CACHE BOOL "" FORCE)
          set(LibUSB_LINK_LIBRARIES "-framework IOKit;-framework CoreFoundation;-framework Security" CACHE STRING "" FORCE)
        else ()
          set(XD_LIBUSB_NAME "libusb-1.0.so.0" CACHE INTERNAL "")
          set(XD_LIBUSB_FILE "${_xd_usb_prefix}/lib/${XD_LIBUSB_NAME}" CACHE INTERNAL "")
        endif ()
      endif ()
      file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
      message(STATUS "xd: libusb ${XD_LIBUSB_VERSION} for SDL: ${LibUSB_LIBRARY}")
    endif ()
  endif ()
endif ()
