{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (slower, easier to troubleshoot)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (fast, with debug info)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "window",
      "displayName": "Release with the 4 GB window ON (docs/MAC_ARM.md; stand-in for the native arm64 Mac build)",
      "inherits": "release",
      "cacheVariables": {
        "XD_ADDR_WINDOW": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux, release (docs/LINUX.md; build with build.sh)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux, debug (docs/LINUX.md; build with build.sh)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-window",
      "displayName": "Linux, release, the 4 GB window ON (docs/MAC_ARM.md; in WSL: ./build.sh window xd)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "XD_ADDR_WINDOW": "ON"
      }
    },
    {
      "name": "linux-window-native",
      "displayName": "Linux, release, the 4 GB window ON, NO stand-in: the mode a native Mac / Android build runs in (docs/MAC_ARM.md; ./build.sh window-native xd)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "XD_ADDR_WINDOW": "ON",
        "XD_WINDOW_NATIVE": "ON"
      }
    },
    {
      "name": "mac-release",
      "displayName": "macOS, release, x86_64 for Rosetta 2 (docs/MAC.md; build with build_mac.sh; never run)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    },
    {
      "name": "mac-arm64-probe",
      "displayName": "macOS, native Apple Silicon (arm64) with the 4 GB window (docs/MAC_ARM.md; never run, workflow stage arm64-probe)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mac/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3",
        "XD_ADDR_WINDOW": "ON"
      }
    },
    {
      "name": "debug-x86",
      "displayName": "Debug, 32-bit (experiment)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-x86",
      "displayName": "Release, 32-bit (experiment)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "window",
      "configurePreset": "window"
    },
    {
      "name": "mac-arm64-probe",
      "configurePreset": "mac-arm64-probe"
    },
    {
      "name": "linux-window",
      "configurePreset": "linux-window"
    },
    {
      "name": "linux-window-native",
      "configurePreset": "linux-window-native"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "debug-x86",
      "configurePreset": "debug-x86"
    },
    {
      "name": "release-x86",
      "configurePreset": "release-x86"
    }
  ]
}
